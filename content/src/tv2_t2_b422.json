  "part1": [
    {
      "type": "title",
      "text": "Bác rất thương loài vật",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Lúc ở chiến khu, Bác Hồ nuôi một con chó,"
    },
    {
      "type": "sentence",
      "text": "một con mèo và một con khỉ."
    },
    {
      "type": "sentence",
      "text": "Thông thường thì ba loài đó vốn chẳng ưa nhau."
    },
    {
      "type": "sentence",
      "text": "Không biết Bác dạy thế nào mà chúng lại quấn quýt nhau,"
    },
    {
      "type": "sentence",
      "text": "thường đùa giỡn, không hề trêu chọc hay cắn nhau bao giờ."
    },
    {
      "type": "sentence",
      "text": "Mỗi lần dời nhà đi, có khi phải hai ngày mới tới chỗ mới,"
    },
    {
      "type": "sentence",
      "text": "bao giờ con khỉ cũng nhảy phốc lên ngồi trên lưng con chó to."
    },
    {
      "type": "sentence",
      "text": "Hễ con chó đi chậm, con khỉ cấu hai tai chó giật giật."
    },
    {
      "type": "sentence",
      "text": "Con chó chạy sải thì khỉ gò lưng như người phi ngựa."
    },
    {
      "type": "sentence",
      "text": "Chó chạy thong thả, khỉ buông thõng hai tay, ngồi ngúc nga ngúc ngắc."
    },
    {
      "type": "sentence",
      "text": "Ai trông thấy cũng phải cười."
    },
    {
      "type": "sentence",
      "text": "Con mèo đen có đốm trắng thì ngao ngao, lững thững chạy theo."
    },
    {
      "type": "sentence",
      "text": "Con khỉ này rất nghịch nên các anh bảo vệ thường phải cột dây."
    },
    {
      "type": "sentence",
      "text": "Khi Bác ăn cơm, Bác mở dây và cho nó ăn."
    },
    {
      "type": "sentence",
      "text": "Bữa nọ, Bác vừa quay lưng ngó ra sân,"
    },
    {
      "type": "sentence",
      "text": "nó bèn rón rén bốc trộm cơm của Bác"
    },
    {
      "type": "sentence",
      "text": "và ngồi yên, giấu nắm cơm trong tay vờ như không có gì xảy ra."
    },
    {
      "type": "sentence",
      "text": "Tôi vội kêu: \"Sao mày bốc cơm của Bác?\""
    },
    {
      "type": "sentence",
      "text": "Con khỉ vội lom khom chạy đi,"
    },
    {
      "type": "sentence",
      "text": "vừa chạy vừa quay lại nhìn như sợ Bác giận."
    },
    {
      "type": "sentence",
      "text": "Bác mỉm cười, nụ cười rất hiền lành."
    },
    {
      "type": "passage",
      "layout": "prose",
      "author": "DIỆP MINH CHÂU kể, ĐOÀN GIỎI ghi",
