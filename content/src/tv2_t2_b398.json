  "part1": [
    {
      "type": "title",
      "text": "Đoàn tàu chở hàng",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Một đoàn tàu chở hàng đang xình xịch chạy, phun khói trắng xóa."
    },
    {
      "type": "sentence",
      "text": "Phía trước là đầu máy rồi đến năm toa nối nhau."
    },
    {
      "type": "sentence",
      "text": "Toa cuối cùng là một toa bỏ không vừa chạy vừa hò hét to nhất."
    },
    {
      "type": "sentence",
      "text": "Toa củi chạy trước nó liền hỏi:"
    },
    {
      "type": "sentence",
      "text": "- Có gì mà cậu hò hét điếc cả tai thế?"
    },
    {
      "type": "sentence",
      "text": "Chiếc toa không liền trả lời:"
    },
    {
      "type": "sentence",
      "text": "- Tớ là một cái toa danh tiếng lừng lẫy."
    },
    {
      "type": "sentence",
      "text": "Tuần trước tớ đã chở một con sư tử cho vườn bách thú đấy nhé!"
    },
    {
      "type": "sentence",
      "text": "Toa củi nói:"
    },
    {
      "type": "sentence",
      "text": "- Cậu thì có gì ghê gớm!"
    },
    {
      "type": "sentence",
      "text": "Nếu tôi không kéo cậu đi thì cậu phải đứng ì tại chỗ."
    },
    {
      "type": "sentence",
      "text": "Toa khoai nghe nói vậy, lanh canh lên tiếng:"
    },
    {
      "type": "sentence",
      "text": "- Thôi đi các cậu! Chính tôi kéo hai cậu chạy theo!"
    },
    {
      "type": "sentence",
      "text": "Toa gạo mỉa mai nói:"
    },
    {
      "type": "sentence",
      "text": "- Nói gì vậy? Cả ba cậu đều do tôi kéo hết!"
    },
    {
      "type": "sentence",
      "text": "Toa sách báo nghe vậy liền cười:"
    },
    {
      "type": "sentence",
      "text": "- Các cậu nhầm rồi! Chính tôi kéo cả bốn cậu."
    },
    {
      "type": "sentence",
      "text": "Đầu máy thở phì phì và tức giận nói:"
    },
    {
      "type": "sentence",
      "text": "- Sao các cậu kiêu căng đến thế!"
    },
    {
      "type": "sentence",
      "text": "Không có tớ thì tất cả các cậu đều chết dí tại chỗ!"
    },
    {
      "type": "sentence",
      "text": "Bỗng đoàn tàu chạy chậm chậm dần rồi dừng lại..."
    },
    {
      "type": "sentence",
      "text": "Toa sách báo liền hỏi:"
    },
    {
      "type": "sentence",
      "text": "- Anh đầu máy! Tại sao anh không chạy?"
    },
    {
      "type": "sentence",
      "text": "Anh vừa bảo anh kéo tất cả chúng tôi cơ mà?"
    },
    {
      "type": "sentence",
      "text": "Đầu máy trả lời:"
    },
    {
      "type": "sentence",
      "text": "- Người lái tàu hãm tôi lại."
    },
    {
      "type": "sentence",
      "text": "Và người ấy đã muốn thì tôi đành chịu!"
    },
