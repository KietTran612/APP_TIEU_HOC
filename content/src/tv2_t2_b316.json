  "part1": [
    {
      "type": "title",
      "text": "Làm cách nào dễ hơn",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Ba cậu bé rủ nhau vào rừng."
    },
    {
      "type": "sentence",
      "text": "Trong rừng có nấm, có quả rừng, lại có đủ các thứ chim."
    },
    {
      "type": "sentence",
      "text": "Ba cậu mải chơi nên không để ý là trời đã về chiều, sắp tối."
    },
    {
      "type": "sentence",
      "text": "Về bây giờ thì sợ lắm!"
    },
    {
      "type": "sentence",
      "text": "Cả ba cố nghĩ ngợi tìm xem cách nào dễ hơn:"
    },
    {
      "type": "sentence",
      "text": "nói dối hay là thú thật?"
    },
    {
      "type": "sentence",
      "text": "Cậu thứ nhất nói:"
    },
    {
      "type": "sentence",
      "text": "- Tớ sẽ nói dối là bị chó sói đuổi ở trong rừng."
    },
    {
      "type": "sentence",
      "text": "Bố tớ phát hoảng lên và thế là thôi không mắng nữa."
    },
    {
      "type": "sentence",
      "text": "Cậu thứ hai nói:"
    },
    {
      "type": "sentence",
      "text": "- Tớ sẽ nói là đang đi đường thì gặp ông ngoại."
    },
    {
      "type": "sentence",
      "text": "Mẹ tớ sẽ vui và cũng không mắng tớ."
    },
    {
      "type": "sentence",
      "text": "Cậu thứ ba nói:"
    },
    {
      "type": "sentence",
      "text": "- Còn mình thì mình sẽ nói thật,"
    },
    {
      "type": "sentence",
      "text": "vì nói thật thì chẳng cần phải nghĩ tìm cách này hay cách khác."
    },
    {
      "type": "sentence",
      "text": "Thế rồi ba cậu bé chia tay nhau về nhà."
    },
    {
      "type": "sentence",
      "text": "Cậu thứ nhất vừa nói với bố xong thì đúng lúc bác coi rừng đến chơi."
    },
    {
      "type": "sentence",
      "text": "Bác nói:"
    },
    {
      "type": "sentence",
      "text": "- Không, trong rừng này làm gì có chó sói."
    },
    {
      "type": "sentence",
      "text": "Người cha bực tức vô cùng."
    },
    {
      "type": "sentence",
      "text": "Vì tội đi chơi về muộn cũng đủ tức lắm rồi,"
    },
    {
      "type": "sentence",
      "text": "vậy mà lại còn nói dối nữa nên tức lên gấp đôi."
    },
    {
      "type": "sentence",
      "text": "Cậu thứ hai đang nói với mẹ là đi đường gặp ông ngoại"
    },
    {
      "type": "sentence",
      "text": "thì vừa lúc ông ngoại bước vào."
    },
    {
      "type": "sentence",
      "text": "Bà mẹ cũng bực tức vô cùng."
    },
    {
      "type": "sentence",
      "text": "Vì tội đi chơi về muộn cũng đủ tức lắm rồi,"
    },
    {
      "type": "sentence",
      "text": "vậy mà lại còn nói dối nữa nên tức lên gấp đôi."
    },
    {
      "type": "sentence",
      "text": "Còn cậu thứ ba, vừa về đến nhà, đã nhận lỗi ngay từ cửa."
    },
    {
      "type": "sentence",
      "text": "Bố cậu chỉ căn dặn một câu và hoàn toàn tha thứ cho cậu."
    },
