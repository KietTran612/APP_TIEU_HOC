  "part1": [
    {
      "type": "title",
      "text": "Rừng miền đông",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Đang vào mùa rừng dầu trút lá."
    },
    {
      "type": "sentence",
      "text": "Tàu lá dầu liệng xuống như cánh diều, phủ vàng mặt đất."
    },
    {
      "type": "sentence",
      "text": "Mỗi khi có con hoẵng chạy qua,"
    },
    {
      "type": "sentence",
      "text": "thảm lá khô vang động như có ai đang bẻ chiếc bánh đa."
    },
    {
      "type": "sentence",
      "text": "Những cây dầu con mới lớn,"
    },
    {
      "type": "sentence",
      "text": "phiến lá đã to gần bằng lá già rụng xuống."
    },
    {
      "type": "sentence",
      "text": "Lá như cái quạt nan che lấp cả thân cây."
    },
    {
      "type": "sentence",
      "text": "Đang giữa trưa nắng, gặp rừng dầu non,"
    },
    {
      "type": "sentence",
      "text": "mắt bỗng dịu lại như đang lạc vào một vùng rau xanh mát."
    },
    {
      "type": "sentence",
      "text": "Hết rừng dầu lại đến rừng cao su."
    },
    {
      "type": "sentence",
      "text": "Màu xanh lá dầu chỉ có thể so sánh với màu cao su vừa thay lá."
    },
    {
      "type": "sentence",
      "text": "Những cánh rừng cao su thăm thẳm, như những cái hang động màu ngọc bích."
    },
    {
      "type": "sentence",
      "text": "Sắc lá càng xanh biếc trong màu đất đỏ tươi."
    },
    {
      "type": "passage",
      "layout": "prose",
      "author": "CHU LAI",
