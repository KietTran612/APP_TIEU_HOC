  "part1": [
    {
      "type": "title",
      "text": "Chế giễu người lười",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "- Ăn no rồi lại nằm khoèo"
    },
    {
      "type": "sentence",
      "text": "Nghe giục trống chèo bế bụng đi xem."
    },
    {
      "type": "sentence",
      "text": "- Có làm thì mới có ăn"
    },
    {
      "type": "sentence",
      "text": "Không dưng ai dễ đem phần đến cho."
    },
    {
      "type": "sentence",
      "text": "- Vốn tôi có máu đau hàm"
    },
    {
      "type": "sentence",
      "text": "Cơm ăn thì đỡ, việc làm thì đau."
    },
    {
      "type": "sentence",
      "text": "- Ăn thì chọn những miếng ngon"
    },
    {
      "type": "sentence",
      "text": "Làm thì chọn việc cỏn con mà làm."
    },
    {
      "type": "sentence",
      "text": "- Làm trai cho đáng sức trai"
    },
    {
      "type": "sentence",
      "text": "Khom lưng cố sức gánh hai hạt vừng."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "Tục ngữ Việt Nam",
