  "part1": [
    {
      "type": "title",
      "text": "Lòng mẹ",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Đêm đã khuya."
    },
    {
      "type": "sentence",
      "text": "Mẹ Thắng vẫn ngồi cặm cụi làm việc."
    },
    {
      "type": "sentence",
      "text": "Chiều nay, trời trở rét."
    },
    {
      "type": "sentence",
      "text": "Mẹ cố may cho xong tấm áo"
    },
    {
      "type": "sentence",
      "text": "để ngày mai Thắng có thêm áo ấm đi học."
    },
    {
      "type": "sentence",
      "text": "Chốc chốc, Thắng trở mình,"
    },
    {
      "type": "sentence",
      "text": "mẹ dừng mũi kim, đắp lại chăn cho Thắng ngủ ngon."
    },
    {
      "type": "sentence",
      "text": "Nhìn khuôn mặt sáng sủa, bầu bĩnh của Thắng, mẹ thấy vui trong lòng."
    },
    {
      "type": "sentence",
      "text": "Tay mẹ đưa mũi kim nhanh hơn."
    },
    {
      "type": "sentence",
      "text": "Bên ngoài, tiếng gió bấc rào rào trong vườn chuối."
    },
    {
      "type": "passage",
      "layout": "prose",
      "author": "H.T.",
