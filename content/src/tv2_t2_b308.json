  "part1": [
    {
      "type": "title",
      "text": "Xe lu và xe ca",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Xe lu và xe ca cùng đi trên đường với nhau."
    },
    {
      "type": "sentence",
      "text": "Thấy xe lu đi chậm, xe ca chế:"
    },
    {
      "type": "sentence",
      "text": "- Cậu đi như con rùa ấy! Xem tớ đây này!"
    },
    {
      "type": "sentence",
      "text": "Nói rồi, xe ca phóng vụt lên, bỏ xe lu ở tít đằng sau."
    },
    {
      "type": "sentence",
      "text": "Xe ca tưởng mình thế là giỏi lắm."
    },
    {
      "type": "sentence",
      "text": "Tới một quãng đường bị hỏng, xe ca phải đỗ lại vì lầy lội quá."
    },
    {
      "type": "sentence",
      "text": "Bấy giờ xe lu mới tiến lên."
    },
    {
      "type": "sentence",
      "text": "Khi đám đá hộc và đá cuội ngổn ngang đổ xuống,"
    },
    {
      "type": "sentence",
      "text": "xe lu liền lăn qua lăn lại cho phẳng lì."
    },
    {
      "type": "sentence",
      "text": "Nhờ vậy mà xe ca mới tiếp tục lên đường."
    },
    {
      "type": "sentence",
      "text": "Từ đấy, xe ca không chế giễu xe lu nữa."
    },
    {
      "type": "sentence",
      "text": "Xe ca đã hiểu rằng: công việc của xe lu là như vậy."
    },
    {
