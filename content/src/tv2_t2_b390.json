  "part1": [
    {
      "type": "title",
      "text": "Bác thợ xây vui tính",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Trời gần đứng bóng, Hòe đang rảo bước trên vỉa hè."
    },
    {
      "type": "sentence",
      "text": "Bỗng một tiếng gọi giật lại:"
    },
    {
      "type": "sentence",
      "text": "- Này, cậu bé, lại đây!"
    },
    {
      "type": "sentence",
      "text": "Hòe vội quay lại."
    },
    {
      "type": "sentence",
      "text": "Bác thợ xây quen thuộc đang tươi cười hồ hởi."
    },
    {
      "type": "sentence",
      "text": "Khuôn mặt tráng nắng còn đọng mấy vệt mồ hôi khô trắng."
    },
    {
      "type": "sentence",
      "text": "- Đói chưa? Đây, ăn đi."
    },
    {
      "type": "sentence",
      "text": "Bác thợ dúi vào tay Hòe một mẩu bánh xốp"
    },
    {
      "type": "sentence",
      "text": "còn nóng hổi lẫn cả mùi nồng của vôi."
    },
    {
      "type": "sentence",
      "text": "Hòe nhoẻn miệng cười hồn nhiên."
    },
    {
      "type": "sentence",
      "text": "Bác vỗ vỗ vào vai Hòe cười ha hả:"
    },
    {
      "type": "sentence",
      "text": "- Cháu thích cái nghề vôi vữa này không đấy?"
    },
    {
      "type": "sentence",
      "text": "- Cháu rất thích ạ."
    },
    {
      "type": "sentence",
      "text": "- Khà khà... tốt lắm!"
    },
    {
      "type": "sentence",
      "text": "Bác thợ vừa trò chuyện vừa xúc hồ trát thoăn thoắt."
    },
    {
      "type": "sentence",
      "text": "Chiếc bay trong tay bác loang loáng."
    },
    {
      "type": "sentence",
      "text": "Bức thành cao lên trông thấy."
    },
    {
      "type": "sentence",
      "text": "Hòe mải xem bác thợ làm, quên cả đói."
    },
