    {
      "type": "sentence",
      "text": "Cứ mỗi độ thu sang,"
    },
    {
      "type": "sentence",
      "text": "Hoa cúc lại nở vàng."
    },
    {
      "type": "sentence",
      "text": "Ngoài vườn, hương thơm ngát,"
    },
    {
      "type": "sentence",
      "text": "Ong, bướm bay rộn ràng."
    },
    {
      "type": "sentence",
      "text": "Em cắp sách tới trường,"
    },
    {
      "type": "sentence",
      "text": "Nắng tươi trải trên đường,"
    },
    {
      "type": "sentence",
      "text": "Trời cao xanh, gió mát,"
    },
    {
      "type": "sentence",
      "text": "Đẹp thay lúc thu sang!"
    },
    {
      "type": "passage",
