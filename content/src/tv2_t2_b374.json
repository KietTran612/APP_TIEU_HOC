      "text": "Làm mưa",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Bước lên đồng trên"
    },
    {
      "type": "sentence",
      "text": "Thấy con sông mới."
    },
    {
      "type": "sentence",
      "text": "Bước xuống đồng dưới"
    },
    {
      "type": "sentence",
      "text": "Thấy con kênh đào."
    },
    {
      "type": "sentence",
      "text": "Bước ra đồng sau"
    },
    {
      "type": "sentence",
      "text": "Thấy máy bơm nước."
    },
    {
      "type": "sentence",
      "text": "Bước ra đồng trước"
    },
    {
      "type": "sentence",
      "text": "Thấy guồng đang quay."
    },
    {
      "type": "sentence",
      "text": "Chẳng mưa từ chín tầng mây,"
    },
    {
      "type": "sentence",
      "text": "Thì mưa từ những bàn tay con người."
    },
    {
