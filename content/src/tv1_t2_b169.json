    },
    {
      "type": "sentence",
      "text": "Ngày xưa, có một người nông dân nghèo đói."
    },
    {
      "type": "sentence",
      "text": "Anh ta phải bỏ làng vào rừng vỡ hoang, trồng trỉa."
    },
    {
      "type": "sentence",
      "text": "Một hôm anh đang gieo hạt cải củ."
    },
    {
      "type": "sentence",
      "text": "Bỗng có một con gấu to ở đâu chạy đến quát lớn:"
    },
    {
      "type": "sentence",
      "text": "- Anh kia! Ai cho phép anh vào rừng của ta?"
    },
    {
      "type": "sentence",
      "text": "Người nông dân bình tĩnh đáp lại:"
    },
    {
      "type": "sentence",
      "text": "- Ông Gấu ơi! Ông để cho tôi gieo ít cải."
    },
    {
      "type": "sentence",
      "text": "Khi cải lớn, tôi chỉ lấy gốc thôi."
    },
    {
      "type": "sentence",
      "text": "Còn tất cả thuộc về phần ông."
    },
    {
      "type": "sentence",
      "text": "Gấu nghe bùi tai, nói:"
    },
    {
      "type": "sentence",
      "text": "- Thế cũng được."
    },
    {
      "type": "sentence",
      "text": "Nhưng anh phải giữ đúng lời hứa."
    },
    {
      "type": "sentence",
      "text": "Nếu không, ta sẽ xé xác."
    },
    {
      "type": "sentence",
      "text": "Cải củ lớn."
    },
    {
      "type": "sentence",
      "text": "Người nông dân đào lấy củ đem về ăn."
    },
    {
      "type": "sentence",
      "text": "Còn ngọn để lại cho gấu."
    },
    {
      "type": "sentence",
      "text": "Gấu ăn thấy đắng, tức lắm, nhưng không làm gì được."
    },
