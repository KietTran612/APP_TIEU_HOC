  "part1": [
    {
      "type": "title",
      "text": "Ai mạnh nhất trên đời",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Chú gà rừng đến bờ sông để tìm nước uống cho đỡ khát."
    },
    {
      "type": "sentence",
      "text": "Chú ta tìm được một chỗ nước chưa đóng băng tròn như cái đĩa."
    },
    {
      "type": "sentence",
      "text": "Chú uống cho đến lúc đôi cánh cũng bị băng đóng cứng đờ."
    },
    {
      "type": "sentence",
      "text": "- Ô! Băng! Anh thật mạnh biết bao!"
    },
    {
      "type": "sentence",
      "text": "- Không đâu gà rừng ạ! Mưa còn mạnh hơn mình nhiều."
    },
    {
      "type": "sentence",
      "text": "Hắn làm mình tan ra thành nước đấy."
    },
    {
      "type": "sentence",
      "text": "Mưa nói:"
    },
    {
      "type": "sentence",
      "text": "- Không, đất mạnh hơn chứ! Mình vừa rơi xuống, hắn đã nuốt chửng."
    },
    {
      "type": "sentence",
      "text": "- Cây mạnh hơn tôi nhiều. - Đất phân trần -"
    },
    {
      "type": "sentence",
      "text": "Hắn đứng ở trên người tôi và hút hết sức mạnh của tôi."
    },
    {
      "type": "sentence",
      "text": "Cây lắc đầu:"
    },
    {
      "type": "sentence",
      "text": "- Không! Lửa mới có sức mạnh ghê gớm."
    },
    {
      "type": "sentence",
      "text": "Hắn thở những lưỡi lửa dài và thiêu tớ thành tro."
    },
    {
      "type": "sentence",
      "text": "- Đúng,"
    },
    {
      "type": "sentence",
      "text": "nhưng chàng Gió lại có thể dập tắt được tớ. - Lửa khiêm tốn đáp lại."
    },
    {
      "type": "sentence",
      "text": "Gió chậm rãi nói:"
    },
    {
      "type": "sentence",
      "text": "- Mình có thể dập tắt lửa, nhưng các bạn xem,"
    },
    {
      "type": "sentence",
      "text": "chàng Cỏ nhóc vẫn đứng hiên ngang trong gió bão."
    },
    {
      "type": "sentence",
      "text": "Cỏ mới xứng đáng là kẻ mạnh nhất."
    },
    {
      "type": "sentence",
      "text": "Cỏ xua tay từ chối:"
    },
    {
      "type": "sentence",
      "text": "- Tôi mà mạnh à? Bác Cừu đến chén tôi ngon ơ, các bạn ạ!"
    },
    {
      "type": "sentence",
      "text": "Cừu kêu to:"
    },
    {
      "type": "sentence",
      "text": "- Không! Không!"
    },
    {
      "type": "sentence",
      "text": "Người có thể bắt gà rừng, làm tan băng, tắm trong mưa, cày đất,"
    },
    {
      "type": "sentence",
      "text": "cưa đổ cây, dập tắt lửa, bắt gió làm việc cho họ,"
    },
    {
      "type": "sentence",
      "text": "cắt cỏ và ăn thịt cả tôi nữa đấy!"
    },
    {
      "type": "sentence",
      "text": "Người đúng là mạnh nhất trên đời."
    },
    {
