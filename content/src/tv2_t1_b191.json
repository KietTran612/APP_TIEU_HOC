  "part1": [
    {
      "type": "title",
      "text": "Chú bộ đội lái máy bay",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Trước giờ vào lớp, chúng em đang chơi thì có một chú bộ đội đến."
    },
    {
      "type": "sentence",
      "text": "Chú đội chiếc mũ có ông sao trên nền xanh da trời."
    },
    {
      "type": "sentence",
      "text": "Chú hỏi thăm cô giáo."
    },
    {
      "type": "sentence",
      "text": "Một bạn vào thưa với cô."
    },
    {
      "type": "sentence",
      "text": "Cô vội vàng bước ra."
    },
    {
      "type": "sentence",
      "text": "Chú bộ đội cũng bước nhanh tới, vội ngả chiếc mũ xuống:"
    },
    {
      "type": "sentence",
      "text": "- Em chào cô ạ!"
    },
    {
      "type": "sentence",
      "text": "Cô giáo bỗng đứng sững lại."
    },
    {
      "type": "sentence",
      "text": "Chúng em cũng nín lặng vây quanh."
    },
    {
      "type": "sentence",
      "text": "- Thưa cô, em về thăm sức khỏe của cô!"
    },
    {
      "type": "sentence",
      "text": "Cô giáo như chợt nhớ ra:"
    },
    {
      "type": "sentence",
      "text": "- À! Em Thanh! Em lái máy bay à?..."
    },
    {
      "type": "sentence",
      "text": "Em còn nhớ cô ư?"
    },
    {
      "type": "sentence",
      "text": "- Thưa cô, dù bao nhiêu năm nữa, dù đi đâu rất xa,"
    },
    {
      "type": "sentence",
      "text": "em vẫn là học sinh cũ của cô,"
    },
    {
      "type": "sentence",
      "text": "đã từng được cô dìu dắt, dạy bảo."
    },
