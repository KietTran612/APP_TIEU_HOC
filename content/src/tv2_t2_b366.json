      "type": "title",
      "text": "Những cái chân",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Cái gậy có một chân"
    },
    {
      "type": "sentence",
      "text": "Biết giúp bà khỏi ngã."
    },
    {
      "type": "sentence",
      "text": "Chiếc com pa bố vẽ"
    },
    {
      "type": "sentence",
      "text": "Có chân đứng, chân quay."
    },
    {
      "type": "sentence",
      "text": "Cái kiềng đun hằng ngày"
    },
    {
      "type": "sentence",
      "text": "Ba chân xòe trong lửa."
    },
    {
      "type": "sentence",
      "text": "Chẳng bao giờ đi cả"
    },
    {
      "type": "sentence",
      "text": "Là chiếc bàn bốn chân."
    },
    {
      "type": "sentence",
      "text": "Riêng cái võng Trường Sơn"
    },
    {
      "type": "sentence",
      "text": "Không chân đi khắp nước."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "VŨ QUẦN PHƯƠNG"
    }
  ],
