  "part1": [
    {
      "type": "title",
      "text": "Chiếc dao nóng nảy",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Mi-chi-a cầm dao gọt một chiếc gậy, nhưng gọt một chốc,"
    },
    {
      "type": "sentence",
      "text": "cậu quẳng gậy xuống đất."
    },
    {
      "type": "sentence",
      "text": "Chiếc gậy cong queo, sần sùi, trông thật xấu."
    },
    {
      "type": "sentence",
      "text": "- Sao con quẳng gậy đi? - Bố hỏi."
    },
    {
      "type": "sentence",
      "text": "- Tại dao xấu quá, gọt thế nào cũng không trơn - Mi-chi-a đáp."
    },
    {
      "type": "sentence",
      "text": "- Không! - Bố nói - Dao rất tốt, có điều tính nó nóng nảy."
    },
    {
      "type": "sentence",
      "text": "Con phải dạy cho nó tập kiên nhẫn."
    },
    {
      "type": "sentence",
      "text": "- Dạy thế nào ạ? - Mi-chi-a hỏi."
    },
    {
      "type": "sentence",
      "text": "- Dạy thế này... - bố nói rồi nhặt chiếc gậy lên,"
    },
    {
      "type": "sentence",
      "text": "cầm dao bắt đầu gọt cẩn thận, nhẹ nhàng, từng tí một."
    },
    {
      "type": "sentence",
      "text": "Bây giờ Mi-chi-a hiểu phải dạy dao tập kiên nhẫn như thế nào,"
    },
    {
      "type": "sentence",
      "text": "và cậu bắt chước bố gọt một cách cẩn thận, nhẹ nhàng, từng tí một."
    },
    {
      "type": "sentence",
      "text": "Một hồi lâu, chiếc dao nóng nảy không chịu làm theo ý Mi-chi-a."
    },
    {
      "type": "sentence",
      "text": "Bao giờ nó cũng nóng nảy, vội vàng, tìm cách tuột bên này,"
    },
    {
      "type": "sentence",
      "text": "xén lẹm bên kia, nhưng không được."
    },
    {
      "type": "sentence",
      "text": "Mi-chi-a bắt nó phải kiên nhẫn."
    },
    {
      "type": "sentence",
      "text": "Dần dần chiếc dao gọt tốt hơn."
    },
    {
      "type": "sentence",
      "text": "Trơn."
    },
    {
      "type": "sentence",
      "text": "Đều."
    },
    {
