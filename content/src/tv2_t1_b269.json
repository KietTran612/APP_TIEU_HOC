      "text": "Chim én tìm tổ",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Chim én ngày nào"
    },
    {
      "type": "sentence",
      "text": "Trên mái tranh nhà ta xây tổ"
    },
    {
      "type": "sentence",
      "text": "Sáng nay trở về bâng khuâng cánh vỗ"
    },
    {
      "type": "sentence",
      "text": "Vù sang cây sấu"
    },
    {
      "type": "sentence",
      "text": "Vút lên cây mai"
    },
    {
      "type": "sentence",
      "text": "Bay rồi lại đậu"
    },
    {
      "type": "sentence",
      "text": "Đậu rồi lại bay"
    },
    {
      "type": "sentence",
      "text": "Nghĩ gì chim hỡi?"
    },
    {
      "type": "sentence",
      "text": "Chim bay lên mái ngói"
    },
    {
      "type": "sentence",
      "text": "Xanh cửa, trắng tường"
    },
    {
      "type": "sentence",
      "text": "Ríu rít bên nhau xây tổ mới."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "NÔNG QUỐC CHẤN",
