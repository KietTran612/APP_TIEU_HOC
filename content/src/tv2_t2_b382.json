  "part1": [
    {
      "type": "title",
      "text": "Chị công nhân chăn bò",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Chị là con gái miền xuôi,"
    },
    {
      "type": "sentence",
      "text": "Lên chăn bò sữa núi đồi Sa Pa."
    },
    {
      "type": "sentence",
      "text": "Đồi bát ngát, núi bao la,"
    },
    {
      "type": "sentence",
      "text": "Đây là Thác Bạc, kia là Cầu Mây."
    },
    {
      "type": "sentence",
      "text": "Cỏ hương, cỏ sữa mọc đầy,"
    },
    {
      "type": "sentence",
      "text": "Đường đi, con suối lượn ngay chân đèo."
    },
    {
      "type": "sentence",
      "text": "Hàng sa mu đứng nhìn theo,"
    },
    {
      "type": "sentence",
      "text": "Đêm khuya, một mảnh trăng treo trên ngàn."
    },
    {
      "type": "sentence",
      "text": "Nhìn đàn bò sữa nông trường"
    },
    {
      "type": "sentence",
      "text": "Trắng, đen, lang, đốm trong sương hiện dần."
    },
    {
      "type": "sentence",
      "text": "Càng yêu mến chị công nhân,"
    },
    {
      "type": "sentence",
      "text": "Đẹp như một đóa hoa xuân núi rừng."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "TẾ HANH"
    },
    {
      "type": "rule",
      "marker": ":",
      "lines": [
        "Sa mu: một loại cây giống cây thông."
      ]
    }
  ],
