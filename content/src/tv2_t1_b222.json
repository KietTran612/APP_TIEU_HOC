  "part1": [
    {
      "type": "title",
      "text": "Ông tôi",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Ông tôi năm nay đã già lắm."
    },
    {
      "type": "sentence",
      "text": "Tóc ông bạc phơ và ông không thể ăn mía như tôi được."
    },
    {
      "type": "sentence",
      "text": "Thế mà hôm nọ, ông lại trồng một cây ổi,"
    },
    {
      "type": "sentence",
      "text": "giống ổi Bo, quả to, thơm ngọt."
    },
    {
      "type": "sentence",
      "text": "Tôi liền hỏi:"
    },
    {
      "type": "sentence",
      "text": "- Ông ơi, ông ăn ổi làm sao được nữa ạ?"
    },
    {
      "type": "sentence",
      "text": "Ông tôi nhìn tôi, móm mém cười:"
    },
    {
      "type": "sentence",
      "text": "- Ông không ăn được thì đã có cháu ông ăn!"
    },
    {
      "type": "sentence",
      "text": "Ông tôi đã già, thế mà không một ngày nào ông quên ra vườn."
    },
    {
      "type": "sentence",
      "text": "Tôi vẫn thường tha thẩn theo ông, khi xới gốc, lúc tưới nước giúp ông."
    },
    {
      "type": "sentence",
      "text": "Tôi thầm mong sao cho ông tôi đừng già thêm nữa."
    },
