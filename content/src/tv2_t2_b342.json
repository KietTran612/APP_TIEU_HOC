  "part1": [
    {
      "type": "title",
      "text": "Cái ổ gà",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Chiều nay, Dũng đứng chơi trước cửa chờ đón bố về."
    },
    {
      "type": "sentence",
      "text": "Dũng nhìn xe cộ và mọi người qua đường."
    },
    {
      "type": "sentence",
      "text": "Một bác chở một bó củi sau xe đạp,"
    },
    {
      "type": "sentence",
      "text": "định tránh ổ gà thì một chiếc xe khác ở phía trước xô tới."
    },
    {
      "type": "sentence",
      "text": "Bác luống cuống đưa luôn xe xuống ổ gà."
    },
    {
      "type": "sentence",
      "text": "Bó củi lọc xọc, đứt dây, rơi vung vãi."
    },
    {
      "type": "sentence",
      "text": "Bác suýt ngã, vội vàng xuống xe, lúng túng nhặt từng que củi."
    },
    {
      "type": "sentence",
      "text": "Bọn trẻ cứ đứng mà cười."
    },
    {
      "type": "sentence",
      "text": "Lát sau,"
    },
    {
      "type": "sentence",
      "text": "một chiếc xe khác lại gặp phải ổ gà; sau xe có một em bé."
    },
    {
      "type": "sentence",
      "text": "Xe xóc mạnh, em bé suýt ngã."
    },
    {
      "type": "sentence",
      "text": "Bà mẹ tay lái loạng choạng, cũng suýt ngã."
    },
    {
      "type": "sentence",
      "text": "Rồi đường vắng dần, xe qua lại thưa thớt đi."
    },
    {
      "type": "sentence",
      "text": "Bố về."
    },
    {
      "type": "sentence",
      "text": "Hết chuyện này đến chuyện khác,"
    },
    {
      "type": "sentence",
      "text": "cuối cùng Dũng kể cho bố nghe về cái ổ gà."
    },
    {
      "type": "sentence",
      "text": "Dũng chưa kể hết, bố đã hỏi ngay:"
    },
    {
      "type": "sentence",
      "text": "- Thế con cứ đứng mà xem à? Sao con không lấp nó đi?"
    },
    {
      "type": "sentence",
      "text": "Dũng đỏ ra!"
    },
    {
      "type": "sentence",
      "text": "Có thế mà cũng không nghĩ đến!"
    },
    {
      "type": "sentence",
      "text": "Dũng ấp úng:"
    },
    {
      "type": "sentence",
      "text": "- Con quên mất!"
    },
    {
      "type": "sentence",
      "text": "Dũng vội đi lấy cái xô và cái xẻng con vẫn xúc cát chơi."
    },
    {
      "type": "sentence",
      "text": "Hai bố con ra đến đường thì cái ổ gà tai ác đã được lấp phẳng."
    },
    {
      "type": "sentence",
      "text": "Chắc là một bạn nào đã kể cho bố bạn ấy nghe trước Dũng."
    },
    {
      "type": "sentence",
      "text": "Dũng thấy tiếc quá!"
    },
    {
