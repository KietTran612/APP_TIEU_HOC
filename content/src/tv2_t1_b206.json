  "part1": [
    {
      "type": "title",
      "text": "Vượt bậc",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Hôm chủ nhật, bố và Nam đến nhà bác chơi."
    },
    {
      "type": "sentence",
      "text": "Nam có một chuyện rất thú."
    },
    {
      "type": "sentence",
      "text": "Nam sẽ kể cho các chị nghe."
    },
    {
      "type": "sentence",
      "text": "Tháng này, Nam vượt từ thứ hai mươi lên thứ tám trong lớp."
    },
    {
      "type": "sentence",
      "text": "Nam được cô giáo khen là học khá."
    },
    {
      "type": "sentence",
      "text": "Vừa xuống xe, Nam chạy ngay đến chỗ chị Bích, chị Diệp."
    },
    {
      "type": "sentence",
      "text": "- Chị Bích, chị Diệp ơi!"
    },
    {
      "type": "sentence",
      "text": "Tháng này xếp thứ, em vượt được những mười hai bậc đấy nhé!"
    },
    {
      "type": "sentence",
      "text": "- Thế cơ à! - Bích và Diệp cùng reo lên."
    },
    {
      "type": "sentence",
      "text": "Nhìn hai chị tròn xoe mắt, Nam càng thích chí."
    },
    {
      "type": "sentence",
      "text": "- Thế còn chị Diệp vượt được mấy bậc?"
    },
    {
      "type": "sentence",
      "text": "- Được... - Diệp bối rối - được một bậc thôi!"
    },
    {
      "type": "sentence",
      "text": "- Thế chị Bích?"
    },
    {
      "type": "sentence",
      "text": "- Chị thì... - Bích càng tỏ ra bối rối hơn - chị thì chả vượt được bậc nào."
    },
    {
      "type": "sentence",
      "text": "- Thế các chị có được cô giáo khen là khá không?"
    },
    {
      "type": "sentence",
      "text": "- Không."
    },
    {
      "type": "sentence",
      "text": "- Thế cô giáo khen thế nào?"
    },
    {
      "type": "sentence",
      "text": "- Cô giáo khen là... giỏi!"
    },
    {
      "type": "sentence",
      "text": "Ô! Nam ngẩn người ra và chớp mắt lia lịa."
    },
    {
      "type": "sentence",
      "text": "Giỏi thì hơn khá đứt đuôi đi rồi."
    },
    {
      "type": "sentence",
      "text": "Nhưng sao các chị ấy vượt được ít bậc"
    },
    {
      "type": "sentence",
      "text": "như thế mà lại được khen là giỏi nhỉ?"
    },
    {
      "type": "sentence",
      "text": "Lạ quá."
    },
    {
      "type": "sentence",
      "text": "Chợt bố Nam đứng bên cạnh cười rất to:"
    },
    {
      "type": "sentence",
      "text": "- Vì chị Diệp tháng trước xếp thứ nhì, tháng này lên thứ nhất,"
    },
    {
      "type": "sentence",
      "text": "vượt được một bậc."
    },
    {
      "type": "sentence",
      "text": "Còn chị Bích thì toàn xếp thứ nhất thôi."
    },
    {
      "type": "sentence",
      "text": "Con hiểu chưa?"
    },
    {
      "type": "sentence",
      "text": "À, bây giờ thì Nam hiểu."
    },
    {
      "type": "sentence",
      "text": "Các chị ấy giỏi thật."
    },
    {
      "type": "sentence",
      "text": "Thế mà chả ai nói trước cho Nam biết!"
    },
