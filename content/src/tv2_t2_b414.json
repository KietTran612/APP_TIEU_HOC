  "part1": [
    {
      "type": "title",
      "text": "Một que diêm",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Sau khi đến thăm nhà câu lạc bộ, nhà ăn và ra xem chuồng lợn,"
    },
    {
      "type": "sentence",
      "text": "Bác đi vào nhà bếp."
    },
    {
      "type": "sentence",
      "text": "Thấy đồng chí Hào, tổ trưởng anh nuôi của đơn vị"
    },
    {
      "type": "sentence",
      "text": "đang bê một nồi cơm to từ trên bếp lò xuống, Bác vui vẻ hỏi:"
    },
    {
      "type": "sentence",
      "text": "- Mỗi bữa chú ăn được mấy bát?"
    },
    {
      "type": "sentence",
      "text": "- Thưa Bác, cháu ăn được ba bát ạ!"
    },
    {
      "type": "sentence",
      "text": "Bác thân mật nói tiếp:"
    },
    {
      "type": "sentence",
      "text": "- Chú ăn được như vậy là tốt!"
    },
    {
      "type": "sentence",
      "text": "Nói xong, Bác mở hộp thuốc lá lấy một điếu đưa cho Hào:"
    },
    {
      "type": "sentence",
      "text": "- Bác biếu chú, hút đi!"
    },
    {
      "type": "sentence",
      "text": "Rồi Bác lấy một điếu khác ra để hút."
    },
    {
      "type": "sentence",
      "text": "Thấy Bác đang tìm đóm để châm lửa,"
    },
    {
      "type": "sentence",
      "text": "Hào nhanh nhẹn rút bao diêm trong túi áo mình ra,"
    },
    {
      "type": "sentence",
      "text": "lấy một que định quẹt lửa mời Bác."
    },
    {
      "type": "sentence",
      "text": "Bác liền giơ tay ngăn lại:"
    },
    {
      "type": "sentence",
      "text": "- Chú để dành diêm mà nhóm bếp. Bác châm lửa ở trong lò cũng được."
    },
    {
      "type": "sentence",
      "text": "Ngừng một lát, Bác hỏi Hào:"
    },
    {
      "type": "sentence",
      "text": "- Chú có biết phải qua tay bao nhiêu người mới làm ra một que diêm không?"
    },
    {
      "type": "sentence",
      "text": "- Thưa Bác có ạ!"
    },
    {
      "type": "sentence",
      "text": "Bác ân cần nhắc nhở:"
    },
    {
      "type": "sentence",
      "text": "- Vì vậy mỗi khi dùng một que diêm,"
    },
    {
      "type": "sentence",
      "text": "chúng ta cũng phải nghĩ tới công sức của bao nhiêu người!"
    },
