  "part1": [
    {
      "type": "title",
      "text": "Câu chuyện đàn ong mật",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Ngày xưa có một người đàn bà tên là nàng Ong."
    },
    {
      "type": "sentence",
      "text": "Nàng Ong làm việc chăm chỉ nhưng vẫn nghèo túng vì nhà đông miệng ăn."
    },
    {
      "type": "sentence",
      "text": "Nàng Ong mong các con khôn lớn để đỡ đần mình."
    },
    {
      "type": "sentence",
      "text": "Nhưng lũ con nàng, đứa nào cũng lười."
    },
    {
      "type": "sentence",
      "text": "Nàng thường khuyên các con:"
    },
    {
      "type": "sentence",
      "text": "Muốn no thì phải chăm làm"
    },
    {
      "type": "sentence",
      "text": "Một hạt thóc vàng, chín giọt mồ hôi."
    },
    {
      "type": "sentence",
      "text": "Nhưng không đứa nào nghe."
    },
    {
      "type": "sentence",
      "text": "Lũ con gái nói: \"Chúng con sẽ đi tìm cái khung cửi thần."
    },
    {
      "type": "sentence",
      "text": "Cái khung cửi ấy, cứ gõ vào là ra vải, không cần khó nhọc ngồi dệt\"."
    },
    {
      "type": "sentence",
      "text": "Lũ con trai nói: \"Chúng con sẽ vào rừng tìm cái rìu vàng của thần núi."
    },
    {
      "type": "sentence",
      "text": "Người ta bảo cái rìu ấy có thể tự ngả cây, người không phải mó tay vào\"."
    },
    {
      "type": "sentence",
      "text": "Thế rồi một hôm, chúng bỏ nhà ra đi để nàng Ong ở nhà vò võ một mình."
    },
    {
      "type": "sentence",
      "text": "Nàng buồn phiền mà chết."
    },
    {
      "type": "sentence",
      "text": "Mấy năm sau, lũ con nàng Ong trở về."
    },
    {
      "type": "sentence",
      "text": "Đứa nào cũng rách rưới, xanh xao, vàng vọt."
    },
    {
      "type": "sentence",
      "text": "Chúng đã đi khắp núi cao, rừng sâu nhưng không tìm được vật quý."
    },
    {
      "type": "sentence",
      "text": "Hổ thẹn vì không nghe lời mẹ dạy, chúng bảo nhau chăm chỉ làm ăn."
    },
    {
      "type": "sentence",
      "text": "Khi chết, chúng gặp nàng Ong."
    },
    {
      "type": "sentence",
      "text": "Mẹ con biến thành loài ong bây giờ."
    },
    {
      "type": "sentence",
      "text": "Mẹ biến thành Ong Chúa, các con biến thành Ong Thợ."
    },
    {
      "type": "sentence",
      "text": "Ong Thợ làm việc suốt ngày."
    },
    {
      "type": "sentence",
      "text": "Chúng làm ra mật ngọt lịm mà mọi người ưa thích."
    },
    {
