  "part1": [
    {
      "type": "title",
      "text": "Mùa sương ở Hạ Long",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Đi giữa Hạ Long vào mùa sương,"
    },
    {
      "type": "sentence",
      "text": "ta cảm thấy những hòn đảo vừa xa lạ, vừa quen thuộc, mờ mờ, ảo ảo."
    },
    {
      "type": "sentence",
      "text": "Chung quanh ta, sương buông trắng xóa."
    },
    {
      "type": "sentence",
      "text": "Con thuyền bơi trong sương như bơi trong mây."
    },
    {
      "type": "sentence",
      "text": "Tiếng sóng vỗ long bong bên mạn thuyền."
    },
    {
      "type": "sentence",
      "text": "Tiếng gõ thuyền lộc cộc của bạn chài săn cá,"
    },
    {
      "type": "sentence",
      "text": "âm vang mặt vịnh."
    },
    {
      "type": "sentence",
      "text": "Thỉnh thoảng mấy con hải âu đột ngột hiện ra trong màn sương."
    },
    {
      "type": "sentence",
      "text": "Chúng dang cánh sà xuống mặt nước, rồi vội vã bay vọt lên, vô ý đập vào lá buồm."
    },
    {
      "type": "sentence",
      "text": "Vào mùa sương, ngày ở Hạ Long như ngắn lại."
    },
    {
      "type": "sentence",
      "text": "Buổi sớm, mặt trời lên ngang cột buồm, sương tan, trời mới quang."
    },
    {
      "type": "sentence",
      "text": "Buổi chiều, nắng vừa nhạt, sương đã buông nhanh xuống mặt biển."
    },
    {
      "type": "passage",
      "layout": "prose",
      "author": "THI SẢNH",
      "breaks": [
        9
      ]
    },
    {
