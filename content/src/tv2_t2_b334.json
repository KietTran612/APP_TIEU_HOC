  "part1": [
    {
      "type": "title",
      "text": "Chuyện bé Chăm",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Bé Chăm rất chăm làm nhưng cũng mau chán việc."
    },
    {
      "type": "sentence",
      "text": "Làm việc này chưa xong, em lại bỏ dở để làm việc khác."
    },
    {
      "type": "sentence",
      "text": "Mới quét xong nửa cái sân, em lại lấy sách ra đọc."
    },
    {
      "type": "sentence",
      "text": "Bài học thuộc lòng mới thuộc nửa chừng,"
    },
    {
      "type": "sentence",
      "text": "em lại lấy vở ra để tập chép."
    },
    {
      "type": "sentence",
      "text": "Bố em thường khuyên răn em, nhưng bé Chăm vẫn chưa sửa chữa được."
    },
    {
      "type": "sentence",
      "text": "Một hôm, bố dẫn Chăm đến bác thợ may ở trong làng"
    },
    {
      "type": "sentence",
      "text": "để may một bộ quần áo mới."
    },
    {
      "type": "sentence",
      "text": "Chăm thích quá vì sắp có bộ quần áo đẹp để mặc Tết."
    },
    {
      "type": "sentence",
      "text": "Một ngày, hai ngày và ngày thứ ba, Chăm đến lấy quần áo mới."
    },
    {
      "type": "sentence",
      "text": "Nhưng bác thợ may chỉ may xong nửa cái áo và nửa cái quần."
    },
    {
      "type": "sentence",
      "text": "Bác bảo Chăm cứ thế mặc vào xem sao."
    },
    {
      "type": "sentence",
      "text": "Chăm mặc thử bộ quần áo làm cho mọi người bò lăn ra cười."
    },
    {
      "type": "sentence",
      "text": "Chăm bực tức nói:"
    },
    {
      "type": "sentence",
      "text": "- Thế bác hãy may xong cái áo cho cháu đã có được không?"
    },
    {
      "type": "sentence",
      "text": "Bác làm thế thành ra chẳng cái nào xong hẳn cả!"
    },
    {
      "type": "sentence",
      "text": "Bác thợ nghiêm trang bảo: \"Cháu nói đúng,"
    },
    {
      "type": "sentence",
      "text": "làm việc gì cũng phải làm đến nơi đến chốn mới khỏi phí công vô ích\"."
    },
    {
