  "part1": [
    {
      "type": "title",
      "text": "Hoa phượng",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Hôm qua còn lấm tấm"
    },
    {
      "type": "sentence",
      "text": "Chen lẫn màu lá xanh"
    },
    {
      "type": "sentence",
      "text": "Sáng nay bừng lửa thẫm"
    },
    {
      "type": "sentence",
      "text": "Rừng rực cháy trên cành."
    },
    {
      "type": "sentence",
      "text": "- \"Bà ơi! Sao mà nhanh"
    },
    {
      "type": "sentence",
      "text": "Phượng mở nghìn mắt lửa"
    },
    {
      "type": "sentence",
      "text": "Cả dãy phố nhà mình"
    },
    {
      "type": "sentence",
      "text": "Một trời hoa phượng đỏ."
    },
    {
      "type": "sentence",
      "text": "Hay đêm qua không ngủ"
    },
    {
      "type": "sentence",
      "text": "Chị gió quạt cho cây"
    },
    {
      "type": "sentence",
      "text": "Hay mặt trời ủ lửa"
    },
    {
      "type": "sentence",
      "text": "Cho hoa bừng hôm nay\"."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "LÊ HUY HÒA",
