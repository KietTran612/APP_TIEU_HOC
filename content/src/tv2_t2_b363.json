  "part1": [
    {
      "type": "title",
      "text": "Đứng gác nơi biên giới"
    },
    {
      "type": "sentence",
      "text": "Sớm nay đứng gác, anh Thái thấy Tổ quốc đẹp vô cùng."
    },
    {
      "type": "sentence",
      "text": "Mặt trời hé sáng, rừng núi như tỏa hào quang."
    },
    {
      "type": "sentence",
      "text": "Những tia nắng vàng hắt từ sau dãy núi lên nền trời ửng hồng."
    },
    {
      "type": "sentence",
      "text": "Mặt trời lên, sương tan dần."
    },
    {
      "type": "sentence",
      "text": "Từng cụm mây bạc vật vờ giữa lưng chừng núi, tan vào khe núi."
    },
    {
      "type": "sentence",
      "text": "Thác nước đổ ầm ầm hiện ra trắng xóa."
    },
    {
      "type": "sentence",
      "text": "Rừng cây xanh rung rinh."
    },
    {
      "type": "sentence",
      "text": "Chim chóc cất tiếng ca."
    },
    {
      "type": "sentence",
      "text": "Xa xa trong thung lũng, thấp thoáng bóng người lom khom trên ruộng lúa vàng."
    },
    {
      "type": "sentence",
      "text": "Phong cảnh ở đây thật là hùng vĩ."
    },
    {
      "type": "sentence",
      "text": "Anh Thái nhìn đây đó, tình yêu đất nước rộn ràng trong lòng."
    },
    {
      "type": "sentence",
      "text": "Anh siết chặt thêm cây súng trong tay."
    },
    {
      "type": "passage",
      "layout": "prose",
      "author": "LÊ ĐÀO",
      "breaks": [
        8,
        9
      ]
    },
    {
      "type": "rule",
      "marker": ":",
      "lines": [
        "Hào quang: ánh sáng rực rỡ tỏa ra khắp bốn phía."
      ]
    },
    {
      "type": "question",
      "text": "1. Em hãy tìm trong bài những từ ngữ nói lên vẻ đẹp của cảnh núi rừng buổi sớm.",
      "marker": "?"
    },
    {
      "type": "question",
      "text": "2. Những từ nào tả âm thanh của núi rừng buổi sớm?"
    },
    {
      "type": "question",
      "text": "*3. Anh Thái \"siết chặt thêm cây súng trong tay\" để làm gì?"
    },
    {
      "type": "question",
      "text": "*4. Tìm một từ ghép trong đó có tiếng \"gác\". Đặt một câu với từ đó."
    },
    {
      "type": "question",
      "text": "5. Tìm trong bài một danh từ chung chỉ loài vật và một danh từ chung chỉ đồ vật."
    }
  ],
