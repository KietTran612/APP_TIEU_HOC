  "part1": [
    {
      "type": "title",
      "text": "Có một lần",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Tôi chẳng muốn kể chuyện này vì tôi thấy ngượng quá."
    },
    {
      "type": "sentence",
      "text": "Nhưng dù sao, tôi cũng xin kể để các bạn nghe."
    },
    {
      "type": "sentence",
      "text": "Mọi người đều tưởng là tôi bị đau thật,"
    },
    {
      "type": "sentence",
      "text": "nhưng có phải là tôi bị sưng bộng răng đâu."
    },
    {
      "type": "sentence",
      "text": "Tôi nhét tờ giấy thấm vào mồm, thế là má sưng phồng lên đấy."
    },
    {
      "type": "sentence",
      "text": "Tôi lại nhăn nhó mặt mũi nữa: ôi, đau răng quá!"
    },
    {
      "type": "sentence",
      "text": "Rồi tôi khẽ rên."
    },
    {
      "type": "sentence",
      "text": "Đấy là tôi cố tình làm thế để không bị gọi đọc bài."
    },
    {
      "type": "sentence",
      "text": "Cô giáo tin tôi, các bạn cũng tin."
    },
    {
      "type": "sentence",
      "text": "Ai cũng thương tôi và lo lắng."
    },
    {
      "type": "sentence",
      "text": "Còn tôi thì làm ra vẻ đau lắm."
    },
    {
      "type": "sentence",
      "text": "Cô giáo nói:"
    },
    {
      "type": "sentence",
      "text": "- Em đi về nhà đi! Răng đau thế cơ mà!"
    },
    {
      "type": "sentence",
      "text": "Nhưng tôi không muốn về nhà."
    },
    {
      "type": "sentence",
      "text": "Tôi lấy lưỡi đẩy đi đẩy lại cục giấy thấm trong mồm và nghĩ:"
    },
    {
      "type": "sentence",
      "text": "\"Mình đánh lừa được tất cả mọi người, tài thật!\"."
    },
    {
      "type": "sentence",
      "text": "Bỗng một cậu bạn hét ầm lên:"
    },
    {
      "type": "sentence",
      "text": "- Ôi, nhìn kìa,"
    },
    {
      "type": "sentence",
      "text": "bộng răng sưng của bạn ấy bây giờ chuyển chỗ sang má bên kia rồi."
    },
