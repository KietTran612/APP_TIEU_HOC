  "part1": [
    {
      "type": "title",
      "text": "Cô Chổi Rơm",
      "sub": "Bài đọc thêm"
    },
    {
      "type": "sentence",
      "text": "Trong họ hàng nhà chổi thì cô bé Chổi Rơm vào loại xinh xắn nhất."
    },
    {
      "type": "sentence",
      "text": "Cô có chiếc váy vàng óng, không ai đẹp bằng."
    },
    {
      "type": "sentence",
      "text": "Áo của cô cũng bằng rơm thóc nếp vàng tươi,"
    },
    {
      "type": "sentence",
      "text": "được tết săn lại, cuốn từng vòng quanh người, trông cứ như áo len vậy."
    },
    {
      "type": "sentence",
      "text": "Tuy bé nhưng Chổi Rơm rất được việc."
    },
    {
      "type": "sentence",
      "text": "Ngày hai lần, chị Thùy Linh mang chổi ra quét nhà."
    },
    {
      "type": "sentence",
      "text": "Chỉ quét nhà thôi, còn sân, vườn đã có loại chổi khác cứng hơn."
    },
    {
      "type": "sentence",
      "text": "Chị rất quý Chổi Rơm."
    },
    {
      "type": "sentence",
      "text": "Chị đã nhờ bà đóng cho chiếc đinh sau cánh cửa."
    },
    {
      "type": "sentence",
      "text": "Mỗi lần quét nhà xong, chị treo Chổi Rơm lên đấy"
    },
    {
      "type": "sentence",
      "text": "vừa đỡ ẩm chổi, lại gọn nhà."
    },
    {
      "type": "sentence",
      "text": "Thế là sau những lần lao động mệt nhọc,"
    },
    {
      "type": "sentence",
      "text": "Chổi Rơm được nằm yên ngủ một giấc ngon lành."
    },
    {
