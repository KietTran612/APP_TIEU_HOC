  "part1": [
    {
      "type": "title",
      "text": "Chăm việc cấy cày",
      "sub": "Học thuộc lòng"
    },
    {
      "type": "sentence",
      "text": "- Rủ nhau đi cấy đi cày"
    },
    {
      "type": "sentence",
      "text": "Bây giờ khó nhọc, có ngày phong lưu."
    },
    {
      "type": "sentence",
      "text": "- Ai ơi đừng bỏ ruộng hoang"
    },
    {
      "type": "sentence",
      "text": "Bao nhiêu tấc đất, tấc vàng bấy nhiêu."
    },
    {
      "type": "sentence",
      "text": "- Muốn no thì phải chăm làm"
    },
    {
      "type": "sentence",
      "text": "Một hạt lúa vàng, chín giọt mồ hôi."
    },
    {
      "type": "sentence",
      "text": "- Quanh năm cấy hái cày bừa"
    },
    {
      "type": "sentence",
      "text": "Vụ chiêm tiết hạ, vụ mùa tiết đông."
    },
    {
      "type": "sentence",
      "text": "Ai về nhắn chị em cùng"
    },
    {
      "type": "sentence",
      "text": "Muốn cho no ấm nghề nông chuyên cần."
    },
    {
      "type": "passage",
      "layout": "poem",
      "author": "Ca dao cổ",
      "breaks": [
        2,
        4,
        6
      ]
    },
    {
      "type": "rule",
      "marker": ":",
      "lines": [
        "Phong lưu: ý nói sống no đủ, sung sướng."
      ]
    },
    {
      "type": "question",
      "text": "1. Tại sao \"đi cấy, đi cày\" vất vả, khó nhọc lại \"có ngày phong lưu\"?",
      "marker": "?"
    },
    {
      "type": "question",
      "text": "2. Tại sao tấc đất lại quý như tấc vàng?"
    },
    {
      "type": "question",
      "text": "3. Câu \"Một hạt lúa vàng chín giọt mồ hôi\" ý nói gì?"
    },
    {
      "type": "question",
      "text": "4. Muốn cho no ấm quanh năm, nhà nông phải làm lụng như thế nào?"
    },
    {
      "type": "question",
      "text": "5. Một hạt lúa vàng: Thay từ lúa bằng một từ cùng nghĩa."
    },
    {
      "type": "memorize"
    }
  ],
