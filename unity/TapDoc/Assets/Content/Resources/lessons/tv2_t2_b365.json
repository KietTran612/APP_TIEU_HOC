          "row": 0
        },
        {
          "text": "trên những cái lưng cong cong.",
          "audio": "cau_b365_08",
          "row": 0
        },
        {
          "text": "Nhìn xuống là những chiếc mũ tai bèo lúp xúp",
          "audio": "cau_b365_09",
          "row": 0
        },
        {
          "text": "trên những mái đầu đang cắm về phía trước.",
          "audio": "cau_b365_10",
          "row": 0
        },
        {
          "text": "Những khuôn mặt đỏ bừng.",
          "audio": "cau_b365_11",
          "row": 0
        },
        {
          "text": "Đoàn quân đột ngột chuyển mạnh.",
          "audio": "cau_b365_12",
          "row": 1
        },
        {
          "text": "Những dặm rừng đỏ lên vì bom Mĩ.",
          "audio": "cau_b365_13",
          "row": 1
        },
        {
          "text": "Những rặng rừng xám đi vì chất độc hóa học Mĩ.",
          "audio": "cau_b365_14",
          "row": 1
        },
        {
          "text": "Những dặm rừng đen, cây cháy thành than chọc lên nền trời đầy mây...",
          "audio": "cau_b365_15",
          "row": 1
        },
        {
          "text": "Tất cả, tất cả lướt qua rất nhanh.",
          "audio": "cau_b365_16",
          "row": 1
        }
      ],
