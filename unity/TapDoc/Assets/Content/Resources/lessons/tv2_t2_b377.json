  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Cách viết hoa tên đất",
      "audio": "cau_b377_01",
      "labels": []
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Ở sách Tiếng Việt 2, tập một, các em đã gặp các từ chỉ tên riêng như: Hải Phòng, Ba Vì, Tản Viên, Hồ Gươm.",
          "audio": "cau_b377_02",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Hải Phòng là tên một thành phố.",
          "audio": "cau_b377_03",
          "role": "line"
        },
        {
          "text": "Ba Vì là tên một huyện.",
          "audio": "cau_b377_04",
          "role": "line"
        },
        {
          "text": "Tản Viên là tên một ngọn núi.",
          "audio": "cau_b377_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Hồ Gươm là tên một cái hồ.",
          "audio": "cau_b377_06",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Các danh từ riêng chỉ tên đất đều phải viết hoa chữ cái đầu mỗi tiếng.",
          "audio": "cau_b377_07",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "Kể và viết tên riêng của xã, huyện, tỉnh em ở (nếu ở thành phố kể tên phường, quận, thành phố).",
      "audio": "hoi_b377_01"
    }
  ],
