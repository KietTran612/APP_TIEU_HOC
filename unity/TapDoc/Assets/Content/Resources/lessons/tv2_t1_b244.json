          "audio": "cau_b244_05",
          "row": 1
        },
        {
          "text": "Mái đền lấp ló bên gốc đa già, rễ, lá xum xuê.",
          "audio": "cau_b244_06",
          "row": 1
        },
        {
          "text": "Xa một chút là Tháp Rùa, tường rêu cổ kính,",
          "audio": "cau_b244_07",
          "row": 1
        },
        {
          "text": "xây trên gò đất cỏ mọc xanh um.",
          "audio": "cau_b244_08",
          "row": 1
        },
        {
          "text": "Có buổi, người ta thấy có con rùa lớn,",
          "audio": "cau_b244_09",
          "row": 1
        },
        {
          "text": "đầu to như trái bưởi, nhô lên khỏi mặt nước.",
          "audio": "cau_b244_10",
          "row": 1
        },
        {
          "text": "Nó như lắng nghe tiếng chuông đồng hồ trên tầng cao nhà bưu điện",
          "audio": "cau_b244_11",
          "row": 1
        },
        {
          "text": "buông từng tiếng ngân nga trong gió.",
          "audio": "cau_b244_12",
          "row": 1
        },
        {
          "text": "Tôi thầm nghĩ:",
          "audio": "cau_b244_13",
          "row": 1
        },
        {
          "text": "Không biết có phải con rùa đã từng ngậm thanh kiếm",
          "audio": "cau_b244_14",
          "row": 1
        },
        {
          "text": "của vua Lê thắng giặc đó không?",
          "audio": "cau_b244_15",
          "row": 1
        }
      ],
