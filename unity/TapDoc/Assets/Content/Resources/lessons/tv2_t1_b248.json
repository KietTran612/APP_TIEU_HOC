    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Đặt câu hỏi để tìm bộ phận chính thứ nhất và bộ phận chính thứ hai trong hai câu sau:",
      "audio": "hoi_b248_01",
      "rows": [
        {
          "text": "Chúng em chăm học chăm làm.",
          "audio": "cau_b248_02"
        },
        {
          "text": "Đất nước ta vô cùng tươi đẹp.",
          "audio": "cau_b248_03"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Bộ phận chính thứ hai của câu còn là bộ phận trả lời câu hỏi: \"... như thế nào?\"",
          "audio": "cau_b248_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "title",
      "marker": "",
      "text": "2. Nhìn vào hình vẽ và đặt câu",
