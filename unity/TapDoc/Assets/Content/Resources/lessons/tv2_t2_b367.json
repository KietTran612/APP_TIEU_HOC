    {
      "kind": "khac_sach",
      "text": "Phần chép, viết vào vở không có trong app: bé viết vào vở cùng bố mẹ. Mục \"Viết đúng\" thành bước đọc."
    },
    {
      "kind": "khac_sach",
      "text": "Sắp xếp chữ thành câu: bé nói cùng bố mẹ; điền chỗ trống, ghép đúng làm bằng chạm thẻ."
    },
    {
      "kind": "khac_sach",
      "text": "Sách in \"Xa ra... trong tay\"; đoạn bài là \"Xa xa... trong tay\", app ghi theo bài."
    }
  ],
