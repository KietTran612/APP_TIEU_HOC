  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Danh từ",
      "audio": "cau_b328_01",
      "labels": [
        "Tiếp theo"
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Cụ già, em bé, bộ đội: chỉ người.",
          "audio": "cau_b328_02",
          "role": "line"
        },
        {
          "text": "Mèo, chó, gà, bồ câu: chỉ loài vật.",
          "audio": "cau_b328_03",
          "role": "line"
        },
        {
          "text": "Cam, ổi, mít, dừa: chỉ cây cối.",
          "audio": "cau_b328_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Bàn, ghế, bút chì, sách: chỉ đồ vật.",
          "audio": "cau_b328_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Từ chỉ người, loài vật, cây cối, đồ vật... gọi là danh từ.",
          "audio": "cau_b328_06",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Em hãy tìm những danh từ chỉ người và đồ vật trong bài \"Tủ sách của bạn Sắc\".",
      "audio": "hoi_b328_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tìm 1 danh từ chỉ người, 1 danh từ chỉ loài vật, 1 danh từ chỉ đồ vật trong bài \"Trăng sao cũng hóa xứ người\" (khổ thứ 2).",
      "audio": "hoi_b328_02",
      "rows": [
        {
          "text": "Mẹ ơi! Mua cốm, mua hồng",
          "audio": "cau_b328_07"
        },
        {
          "text": "Mua con cá chép lượn vòng con chơi.",
          "audio": "cau_b328_08"
        },
        {
          "text": "Trăng cao, trăng đẹp, trăng ngời",
          "audio": "cau_b328_09"
        },
        {
          "text": "Mua tàu vũ trụ con ngồi lên trăng.",
          "audio": "cau_b328_10"
        }
      ]
    }
  ],
