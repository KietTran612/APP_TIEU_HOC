    {
      "type": "passage",
      "marker": "",
      "rows": [
        {
          "text": "Ngày xưa có một ông già sinh được bốn người con.",
          "audio": "cau_b305_02",
          "row": 0
        },
        {
          "text": "Một hôm, ông để một bó đũa và một túi tiền trên bàn",
          "audio": "cau_b305_03",
          "row": 0
        },
        {
          "text": "rồi gọi các con lại và bảo:",
          "audio": "cau_b305_04",
          "row": 0
        },
        {
          "text": "- Trong các con,",
          "audio": "cau_b305_05",
          "row": 1
        },
        {
          "text": "ai bẻ gãy được bó đũa này thì cha thưởng cho túi tiền.",
          "audio": "cau_b305_06",
          "row": 1
        },
        {
          "text": "Các người con lần lượt bẻ,",
          "audio": "cau_b305_07",
          "row": 2
        },
        {
          "text": "ai cũng cố hết sức mà không sao bẻ gãy được bó đũa.",
          "audio": "cau_b305_08",
          "row": 2
        },
        {
          "text": "Ông già bèn cởi bó đũa ra,",
          "audio": "cau_b305_09",
          "row": 3
        },
        {
          "text": "rồi bẻ gãy từng chiếc một cách dễ dàng.",
          "audio": "cau_b305_10",
          "row": 3
        },
        {
          "text": "Bốn người con cùng nói:",
          "audio": "cau_b305_11",
          "row": 4
        },
        {
          "text": "- Thưa cha, lấy từng chiếc mà bẻ thì có khó gì!",
          "audio": "cau_b305_12",
          "row": 5
        },
        {
          "text": "Ông già liền bảo:",
          "audio": "cau_b305_13",
          "row": 6
        },
        {
          "text": "- Đúng! Như thế là các con đều thấy rằng chia lẻ ra thì yếu,",
          "audio": "cau_b305_14",
          "row": 7
        },
        {
          "text": "hợp lại thì mạnh.",
          "audio": "cau_b305_15",
          "row": 7
        },
        {
          "text": "Vậy các con phải biết hợp quần và đùm bọc lấy nhau,",
          "audio": "cau_b305_16",
          "row": 7
        },
        {
          "text": "có hợp quần thì mới có sức mạnh.",
          "audio": "cau_b305_17",
          "row": 7
        }
      ],
