      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Một chiếc đũa, một đôi đũa, một bó đũa có gì khác nhau?",
      "audio": "hoi_b305_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tại sao bốn người con không ai bẻ gãy được bó đũa?",
      "audio": "hoi_b305_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Ông già bẻ gãy bó đũa bằng cách nào?",
      "audio": "hoi_b305_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Bài này khuyên ta điều gì?",
