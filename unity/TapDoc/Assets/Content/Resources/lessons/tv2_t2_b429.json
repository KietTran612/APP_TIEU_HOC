    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Bản mường: làng mạc (của đồng bào miền núi).",
          "audio": "cau_b429_16",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Trước nhà Ún Xinh có dãy núi giống hình con gì?",
      "audio": "hoi_b429_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tại sao lại nói: chỉ có mây cưỡi ngựa được thôi?",
      "audio": "hoi_b429_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Câu \"Cái gậy Bác chống đã mòn gần hết\" ý nói gì?",
      "audio": "hoi_b429_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Vì sao Ún Xinh lại nghĩ: \"Không có ngọn núi nào cao hơn Bác\"?",
      "audio": "hoi_b429_04"
    },
    {
      "type": "question",
      "marker": "",
      "text": "5. Tìm từ gần nghĩa với từ leo. Đặt câu với từ đó.",
      "audio": "hoi_b429_05"
    }
  ],
