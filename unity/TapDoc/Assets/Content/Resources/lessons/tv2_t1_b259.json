      "labels": [
        "NGUYỄN CÔNG DƯƠNG",
        "poem"
      ]
    },
    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Lũy tre: nhiều bụi tre trồng thành dãy dày bao quanh làng xóm.",
          "audio": "cau_b259_18",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Nhìn mặt trời nhô lên ở đầu bụi tre, tác giả tưởng tượng ngọn tre đang làm gì?",
      "audio": "hoi_b259_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Buổi trưa thường có những loài vật nào đến với lũy tre và đến để làm gì?",
      "audio": "hoi_b259_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Vào đêm có trăng sao, tác giả thấy lũy tre như thế nào?",
      "audio": "hoi_b259_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Sắp xếp lại thứ tự các từ ngữ sau đây cho thành câu (mỗi câu xếp 2 cách):",
      "audio": "hoi_b259_04",
      "rows": [
        {
          "text": "khuất dần – sau lũy tre – mặt trời",
          "audio": "cau_b259_19"
        },
        {
          "text": "về tổ – lúc chiều tối – chim bay",
          "audio": "cau_b259_20"
        }
      ]
    },
    {
      "type": "memorize",
      "marker": "",
      "rows": [
        {
          "text": "Mỗi sớm mai thức dậy",
          "audio": "cau_b259_02",
          "row": 0
        },
        {
          "text": "Lũy tre xanh rì rào",
          "audio": "cau_b259_03",
          "row": 0
        },
        {
          "text": "Ngọn tre cong gọng vó",
          "audio": "cau_b259_04",
          "row": 0
        },
        {
          "text": "Kéo mặt trời lên cao.",
          "audio": "cau_b259_05",
          "row": 0
        },
        {
          "text": "Những trưa đồng đầy nắng",
          "audio": "cau_b259_06",
          "row": 0
        },
        {
          "text": "Trâu nằm nhai bóng râm",
          "audio": "cau_b259_07",
          "row": 0
        },
        {
          "text": "Tre bần thần nhớ gió",
          "audio": "cau_b259_08",
          "row": 0
        },
        {
          "text": "Chợt về đầy tiếng chim.",
          "audio": "cau_b259_09",
          "row": 0
        },
        {
          "text": "Mặt trời xuống núi ngủ",
          "audio": "cau_b259_10",
          "row": 0
        },
        {
          "text": "Tre nâng vầng trăng lên",
          "audio": "cau_b259_11",
          "row": 0
        },
        {
          "text": "Sao, sao treo đầy cành",
          "audio": "cau_b259_12",
          "row": 0
        },
        {
          "text": "Suốt đêm dài thắp sáng.",
          "audio": "cau_b259_13",
          "row": 0
        },
        {
          "text": "Bỗng gà lên tiếng gáy",
          "audio": "cau_b259_14",
          "row": 0
        },
        {
          "text": "Xôn xao ngoài lũy tre",
          "audio": "cau_b259_15",
          "row": 0
        },
        {
          "text": "Đêm chuyển dần về sáng",
          "audio": "cau_b259_16",
          "row": 0
        },
        {
          "text": "Mầm măng đợi nắng về.",
          "audio": "cau_b259_17",
          "row": 0
        }
      ],
