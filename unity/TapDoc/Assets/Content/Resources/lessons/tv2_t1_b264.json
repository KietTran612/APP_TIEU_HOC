  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Tiếng và chữ",
      "audio": "cau_b264_01",
      "labels": []
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Câu có thể tách ra thành nhiều tiếng.",
          "audio": "cau_b264_02",
          "role": "line"
        },
        {
          "text": "Khi nói, từng tiếng có thể ngắt ra rõ ràng.",
          "audio": "cau_b264_03",
          "role": "line"
        },
        {
          "text": "Khi viết, mỗi tiếng viết thành một chữ.",
          "audio": "cau_b264_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Ví dụ: Sài/Gòn/là/thành/phố/có/vinh/dự/được/mang/tên/Bác/.",
          "audio": "cau_b264_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Tìm số tiếng trong các câu sau:",
      "audio": "hoi_b264_01",
      "rows": [
        {
          "text": "Cảng Sài Gòn có nhiều bến.",
          "audio": "cau_b264_06"
        },
        {
          "text": "Bến Nhà Rồng là nơi Bác Hồ đã ra đi để tìm đường cứu nước.",
          "audio": "cau_b264_07"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Em hãy đặt một câu với từ thành phố. Câu em đặt có mấy tiếng? Được viết thành mấy chữ?",
      "audio": "hoi_b264_02"
    }
  ],
