  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Câu – Hai bộ phận chính",
      "audio": "cau_b217_01",
      "labels": []
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Mẹ Thắng – chưa thành câu.",
          "audio": "cau_b217_02",
          "role": "line"
        },
        {
          "text": "Vá áo – chưa thành câu.",
          "audio": "cau_b217_03",
          "role": "line"
        },
        {
          "text": "Mẹ Thắng vá áo. – đã thành câu.",
          "audio": "cau_b217_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Câu thường phải có đủ hai bộ phận chính.",
          "audio": "cau_b217_05",
          "role": "line"
        },
        {
          "text": "Bộ phận chính thứ nhất đứng trước, bộ phận chính thứ hai đứng sau.",
          "audio": "cau_b217_06",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Điền thêm bộ phận thứ hai cho thành câu:",
      "audio": "hoi_b217_01",
      "rows": [
        {
          "text": "Bố Tuấn...",
          "audio": "cau_b217_07"
        },
        {
          "text": "Thắng...",
          "audio": "cau_b217_08"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Điền thêm bộ phận thứ nhất cho thành câu:",
      "audio": "hoi_b217_02",
      "rows": [
        {
          "text": "... đang ăn cơm.",
          "audio": "cau_b217_09"
        },
        {
          "text": "... may áo mặc rét cho Thắng.",
          "audio": "cau_b217_10"
        }
      ]
    }
  ],
