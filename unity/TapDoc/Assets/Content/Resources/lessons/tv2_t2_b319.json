        "Tiếp theo"
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Em tìm những từ chỉ cây cối trong các bài \"Trên đường đến nhà lao\" và \"Chú bé liên lạc\".",
      "audio": "hoi_b319_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Em kể một số từ chỉ cây cối, hoa quả mà em biết.",
      "audio": "hoi_b319_02"
    },
    {
      "type": "find_words",
      "marker": "",
      "text": "3. Trong bài \"Chú bé liên lạc\", những từ nào chỉ đồ vật?",
      "audio": "hoi_b319_03",
      "rows": [
        {
          "text": "Chú bé loắt choắt",
          "audio": "cau_b319_02",
          "row": 0
        },
        {
          "text": "Cái xắc xinh xinh",
          "audio": "cau_b319_03",
          "row": 0
        },
        {
          "text": "Cái chân thoăn thoắt",
          "audio": "cau_b319_04",
          "row": 0
        },
        {
          "text": "Cái đầu nghênh nghênh.",
          "audio": "cau_b319_05",
          "row": 0
        },
        {
          "text": "Ca lô đội lệch",
          "audio": "cau_b319_06",
          "row": 0
        },
        {
          "text": "Mồm huýt sáo vang",
          "audio": "cau_b319_07",
          "row": 0
        },
        {
          "text": "Như con chim chích",
          "audio": "cau_b319_08",
          "row": 0
        },
        {
          "text": "Nhảy trên đường vàng...",
          "audio": "cau_b319_09",
          "row": 0
        },
        {
          "text": "Vụt qua mặt trận",
          "audio": "cau_b319_10",
          "row": 0
        },
        {
          "text": "Đạn bay vèo vèo",
          "audio": "cau_b319_11",
          "row": 0
        },
        {
          "text": "Thư đề \"Thượng khẩn\"",
          "audio": "cau_b319_12",
          "row": 0
        },
        {
          "text": "Sợ chi hiểm nghèo?",
          "audio": "cau_b319_13",
          "row": 0
        },
        {
          "text": "Đường quê vắng vẻ",
          "audio": "cau_b319_14",
          "row": 0
        },
        {
          "text": "Lúa trổ đòng đòng",
          "audio": "cau_b319_15",
          "row": 0
        },
        {
          "text": "Ca lô chú bé",
          "audio": "cau_b319_16",
          "row": 0
        },
        {
          "text": "Nhấp nhô trên đồng...",
          "audio": "cau_b319_17",
          "row": 0
        }
      ],
