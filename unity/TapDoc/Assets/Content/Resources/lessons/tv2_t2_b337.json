  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Danh từ chung – Danh từ riêng",
      "audio": "cau_b337_01",
      "labels": []
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Nếu cô giáo gọi:",
          "audio": "cau_b337_02",
          "role": "line"
        },
        {
          "text": "- Học sinh lên bảng làm toán!",
          "audio": "cau_b337_03",
          "role": "line"
        },
        {
          "text": "Cả lớp không ai lên bảng cả vì không biết cô giáo gọi ai.",
          "audio": "cau_b337_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Học sinh là danh từ chỉ người nhưng không chỉ cụ thể người nào nên là danh từ chung.",
          "audio": "cau_b337_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Nếu cô giáo gọi:",
          "audio": "cau_b337_06",
          "role": "line"
        },
        {
          "text": "- Em Nguyễn Văn Hùng lên bảng làm toán.",
          "audio": "cau_b337_07",
          "role": "line"
        },
        {
          "text": "Em Hùng liền đi lên bảng.",
          "audio": "cau_b337_08",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Nguyễn Văn Hùng là tên riêng của một học sinh.",
          "audio": "cau_b337_09",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Những danh từ dùng để chỉ tên riêng của một người gọi là danh từ riêng.",
          "audio": "cau_b337_10",
          "role": "line"
        },
        {
          "text": "Danh từ riêng phải viết hoa.",
          "audio": "cau_b337_11",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "Tìm những danh từ chung và danh từ riêng trong bài \"Ai can đảm\" (xếp thành 2 cột: một cột danh từ chung, một cột danh từ riêng).",
      "audio": "hoi_b337_01"
    }
  ],
