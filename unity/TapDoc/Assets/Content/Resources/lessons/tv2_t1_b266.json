    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Hoa mai khác hoa đào như thế nào?",
      "audio": "hoi_b266_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Hoa mai khi nở đẹp như thế nào?",
      "audio": "hoi_b266_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Ngoài màu sắc đẹp, hoa mai còn có gì khiến mọi người ưa thích?",
      "audio": "hoi_b266_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Tác giả ví những đóa hoa mai rung rinh trước gió với hình ảnh gì?",
      "audio": "hoi_b266_04"
    },
    {
      "type": "question",
      "marker": "",
      "text": "5. Đặt câu với mỗi từ sau đây: rung rinh, rập rờn.",
      "audio": "hoi_b266_05"
    }
