    {
      "type": "question",
      "marker": "",
      "text": "1. Đọc lại 29 chữ cái theo đúng thứ tự bảng chữ cái.",
      "audio": "hoi_b393_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Xếp tên các bạn sau đây theo đúng thứ tự bảng chữ cái:",
      "audio": "hoi_b393_02",
      "rows": [
        {
          "text": "Hưng, Vượng, Thịnh, Minh, Lai",
          "audio": "cau_b393_02"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Nếu tên người có cùng chữ cái đầu thì căn cứ vào chữ thứ 2 để xếp thứ tự trước sau.",
          "audio": "cau_b393_03",
          "role": "line"
        },
        {
          "text": "Ví dụ: Hà, Hòa, Hùng.",
          "audio": "cau_b393_04",
          "role": "line"
        },
        {
          "text": "Chữ thứ 2 trong ba người trên là a, o, u.",
          "audio": "cau_b393_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Nếu tên người có 2 chữ cái đầu giống nhau thì căn cứ vào chữ thứ 3 để xếp thứ tự:",
          "audio": "cau_b393_06",
          "role": "line"
        },
        {
          "text": "Dục xếp trước Dung (vì chữ c trước chữ n).",
          "audio": "cau_b393_07",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Xếp tên các bạn sau đây theo thứ tự bảng chữ cái:",
      "audio": "hoi_b393_03",
      "rows": [
        {
          "text": "Định, An, Khả, Phượng, Mạnh,",
          "audio": "cau_b393_08"
        },
        {
          "text": "Điện, Kính, Phụng, Gái, Minh.",
          "audio": "cau_b393_09"
        }
      ]
    }
  ],
