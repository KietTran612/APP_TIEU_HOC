    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Sa Pa: một nơi nghỉ mát nổi tiếng, thuộc tỉnh Lào Cai.",
          "audio": "cau_b275_10",
          "role": "line"
        },
        {
          "text": "Cầu Mây: tên một cái cầu treo, bắc giữa hai sườn núi.",
          "audio": "cau_b275_11",
          "role": "line"
        },
        {
          "text": "Thác Bạc: tên một ngọn thác chảy từ sườn núi xuống, trông như tấm lụa trắng xóa.",
          "audio": "cau_b275_12",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Bộ đội biên phòng: bộ đội canh phòng vùng đất của nước ta giáp với một nước khác.",
          "audio": "cau_b275_13",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Câu thứ 2 tả những cảnh đẹp gì?",
      "audio": "hoi_b275_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Ở câu 3 và 4, ta thấy Sa Pa về mùa hè có những thứ quả gì?",
      "audio": "hoi_b275_02"
    },
    {
      "type": "question",
      "marker": "",
