  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Câu – Hai bộ phận chính",
      "audio": "cau_b225_01",
      "labels": [
        "Tiếp theo"
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Em Nụ đang ngủ.",
          "audio": "cau_b225_02",
          "role": "line"
        },
        {
          "text": "Hỏi: Trong câu, nói đến ai?",
          "audio": "cau_b225_03",
          "role": "line"
        },
        {
          "text": "Trả lời: Nói đến \"Em Nụ\".",
          "audio": "cau_b225_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Kết luận: \"Em Nụ\" là bộ phận chính thứ nhất của câu.",
          "audio": "cau_b225_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Bộ phận chính thứ nhất của câu là bộ phận trả lời câu hỏi: Trong câu, nói đến ai?",
          "audio": "cau_b225_06",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "Đặt câu hỏi để tìm bộ phận chính thứ nhất bằng cách dùng từ \"ai\":",
      "audio": "hoi_b225_01",
      "rows": [
        {
          "text": "Mẹ cho quà bánh.",
          "audio": "cau_b225_07"
        },
        {
          "text": "Bé Hoa đã lớn rồi.",
          "audio": "cau_b225_08"
        },
        {
          "text": "Hai chị em về nhà.",
          "audio": "cau_b225_09"
        }
      ]
    }
  ],
