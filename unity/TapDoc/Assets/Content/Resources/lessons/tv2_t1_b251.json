      "labels": [
        "NGUYỄN BIỂU",
        "poem"
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Những câu thơ nào cho em biết viên gạch ở đây được ví như con người?",
      "audio": "hoi_b251_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Những viên gạch đã nung chín trông tươi đẹp và cứng rắn như thế nào?",
      "audio": "hoi_b251_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Em hiểu gạch \"đi xây cuộc đời\" ý nói gạch dùng để làm gì?",
      "audio": "hoi_b251_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Phân biệt nghĩa của từ chín: cơm chín, chuối chín, gạch chín, chín tuổi.",
      "audio": "hoi_b251_04"
    },
    {
      "type": "question",
      "marker": "",
      "text": "5. Đoạn 1 là thơ mấy tiếng, đoạn 2 là thơ mấy tiếng?",
      "audio": "hoi_b251_05"
    },
    {
      "type": "memorize",
      "marker": "",
      "rows": [
        {
          "text": "Gạch vào lò",
          "audio": "cau_b251_02",
          "row": 0
        },
        {
          "text": "Lửa bùng to,",
          "audio": "cau_b251_03",
          "row": 0
        },
        {
          "text": "Khói ngùn ngụt",
          "audio": "cau_b251_04",
          "row": 0
        },
        {
          "text": "Than đỏ rực",
          "audio": "cau_b251_05",
          "row": 0
        },
        {
          "text": "Suốt đêm ngày.",
          "audio": "cau_b251_06",
          "row": 0
        },
        {
          "text": "Gạch kề vai",
          "audio": "cau_b251_07",
          "row": 0
        },
        {
          "text": "Đứng chịu nóng,",
          "audio": "cau_b251_08",
          "row": 0
        },
        {
          "text": "Hơi lửa bỏng",
          "audio": "cau_b251_09",
          "row": 0
        },
        {
          "text": "Quấn quanh người.",
          "audio": "cau_b251_10",
          "row": 0
        },
        {
          "text": "A! Gạch chín rồi",
          "audio": "cau_b251_11",
          "row": 0
        },
        {
          "text": "Áo hồng sắc lửa",
          "audio": "cau_b251_12",
          "row": 0
        },
        {
          "text": "Lanh canh tiếng cười.",
          "audio": "cau_b251_13",
          "row": 0
        },
        {
          "text": "Gạch ơi! Gạch ơi!",
          "audio": "cau_b251_14",
          "row": 0
        },
        {
          "text": "Gạch rắn, gạch khỏe,",
          "audio": "cau_b251_15",
          "row": 0
        },
        {
          "text": "Áo thắm, áo tươi,",
          "audio": "cau_b251_16",
          "row": 0
        },
        {
          "text": "Gạch chào đất mẹ",
          "audio": "cau_b251_17",
          "row": 0
        },
        {
          "text": "Đi xây cuộc đời.",
          "audio": "cau_b251_18",
          "row": 0
        },
        {
          "text": "Kìa, xe đã đến,",
          "audio": "cau_b251_19",
          "row": 0
        },
        {
          "text": "Còi reo đón mời,",
          "audio": "cau_b251_20",
          "row": 0
        },
        {
          "text": "Từng chuyến, từng chuyến",
          "audio": "cau_b251_21",
          "row": 0
        },
        {
          "text": "Gạch đi đỏ trời.",
          "audio": "cau_b251_22",
          "row": 0
        }
      ],
