  "notes": [
    {
      "kind": "khac_sach",
      "text": "Phần chép, viết vào vở không có trong app: bé viết vào vở cùng bố mẹ. Mục \"Viết đúng\" thành bước đọc."
    },
    {
      "kind": "khac_sach",
      "text": "Điền chỗ trống làm bằng chạm thẻ; viết câu ngắn thì bé nói câu cùng bố mẹ."
    },
    {
      "kind": "khac_sach",
      "text": "Cụm \"... nhở em học bài\" rút ngắn thành \"nhắc nhở\" cho vừa khung."
    }
  ],
