    {
      "type": "sentence",
      "marker": "",
      "text": "Dạy bài thật hay ấy, bố nhé!",
      "audio": "cau_b221_20",
      "items": [
        {
          "text": "Dạy",
          "audio": "tieng_dayj",
          "hl": [],
          "spells": []
        },
        {
