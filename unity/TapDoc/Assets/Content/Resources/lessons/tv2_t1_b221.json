        {
          "text": "thật",
          "audio": "tieng_thaatj",
          "hl": [],
          "spells": []
        },
        {
          "text": "hay",
          "audio": "tieng_hay",
          "hl": [],
          "spells": []
        },
        {
          "text": "ấy",
          "audio": "tieng_aays",
          "hl": [],
          "spells": []
        },
        {
          "text": "bố",
          "audio": "tieng_boos",
