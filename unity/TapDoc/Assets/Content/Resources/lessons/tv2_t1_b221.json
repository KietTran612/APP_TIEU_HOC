          "spells": []
        },
        {
          "text": "nhé",
          "audio": "tieng_nhes",
          "hl": [],
          "spells": []
        }
      ]
    },
    {
      "type": "passage",
      "marker": "",
      "rows": [
        {
          "text": "Bây giờ Hoa đã là chị rồi.",
          "audio": "cau_b221_02",
          "row": 0
        },
        {
          "text": "Mẹ có thêm em Nụ.",
          "audio": "cau_b221_03",
          "row": 0
        },
        {
          "text": "Em Nụ da đỏ hồng đẹp thật.",
          "audio": "cau_b221_04",
          "row": 0
        },
        {
          "text": "Em Nụ cũng đã lớn lên nhiều.",
          "audio": "cau_b221_05",
          "row": 0
        },
        {
          "text": "Em ngủ ít hơn trước,",
          "audio": "cau_b221_06",
          "row": 0
        },
        {
          "text": "có lúc mắt em mở to, vừa đen vừa tròn, cứ nhìn Hoa mãi.",
          "audio": "cau_b221_07",
          "row": 0
        },
        {
          "text": "Hoa yêu em lắm.",
          "audio": "cau_b221_08",
          "row": 0
        },
        {
          "text": "Hoa thích đưa võng ru cho em ngủ.",
          "audio": "cau_b221_09",
          "row": 0
        },
        {
          "text": "Đêm nay, Hoa hát hết cả bài hát mà mẹ vẫn chưa về.",
          "audio": "cau_b221_10",
          "row": 1
        },
        {
          "text": "Từ ngày bố đi bộ đội, mẹ bận việc nhiều hơn.",
          "audio": "cau_b221_11",
          "row": 1
        },
        {
          "text": "Em Nụ đã ngủ.",
          "audio": "cau_b221_12",
          "row": 1
        },
        {
          "text": "Bây giờ Hoa phải viết thư cho bố.",
          "audio": "cau_b221_13",
          "row": 1
        },
        {
          "text": "Vặn to đèn, Hoa ngồi trên ghế, nắn nót viết từng chữ:",
          "audio": "cau_b221_14",
          "row": 1
        },
        {
          "text": "Bố ạ,",
          "audio": "cau_b221_15",
          "row": 2
        },
        {
          "text": "Em Nụ ở nhà ngoan lắm.",
          "audio": "cau_b221_16",
          "row": 3
        },
        {
          "text": "Nó ngủ cũng ngoan nữa.",
          "audio": "cau_b221_17",
          "row": 3
        },
        {
          "text": "Con hết cả bài hát ru em rồi.",
          "audio": "cau_b221_18",
          "row": 3
        },
        {
          "text": "Bao giờ bố về, bố dạy thêm bài khác cho con.",
          "audio": "cau_b221_19",
          "row": 3
        },
        {
          "text": "Dạy bài thật hay ấy, bố nhé!",
          "audio": "cau_b221_20",
          "row": 3
        }
      ],
