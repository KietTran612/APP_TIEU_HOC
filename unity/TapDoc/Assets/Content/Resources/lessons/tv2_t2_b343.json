    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Chú Phạm Tuân là chiến sĩ lái máy bay, anh hùng quân đội. Chú đã hạ được máy bay B52 của giặc Mĩ. Năm 1980 chú đã bay vào vũ trụ cùng với một nhà du hành vũ trụ Liên Xô.",
          "audio": "cau_b343_16",
          "role": "line"
        },
        {
          "text": "Sao Gàu: chòm sao giống hình chiếc gàu.",
          "audio": "cau_b343_17",
          "role": "line"
        },
        {
          "text": "Vịt: sao Vịt, chòm sao giống hình con vịt ở giữa dải sông Ngân Hà.",
          "audio": "cau_b343_18",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Thần Nông: chòm sao ở về phương Nam, giống hình người đội nón, cúi lom khom như đang cấy.",
          "audio": "cau_b343_19",
          "role": "line"
        }
      ]
    }
  ],
