    {
      "type": "rule",
      "marker": ":",
      "items": [
        {
          "text": "Giá trống: cái khung bằng gỗ để đặt (hoặc treo) cái trống.",
          "audio": "cau_b173_18",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Câu thơ nào trong khổ thơ đầu cho em biết cái trống buồn?",
      "audio": "hoi_b173_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tại sao trong mùa hè, cái trống lại buồn?",
      "audio": "hoi_b173_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Tìm một câu trong khổ thơ cuối bài tả cái trống vui.",
      "audio": "hoi_b173_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Tại sao cái trống lại vui?",
      "audio": "hoi_b173_04"
    },
    {
      "type": "memorize",
      "marker": "",
      "rows": [
        {
          "text": "Cái trống trường em",
          "audio": "cau_b173_02",
          "row": 0
        },
        {
          "text": "Mùa hè cũng nghỉ.",
          "audio": "cau_b173_03",
          "row": 0
        },
        {
          "text": "Suốt ba tháng liền",
          "audio": "cau_b173_04",
          "row": 0
        },
        {
          "text": "Trống nằm ngẫm nghĩ.",
          "audio": "cau_b173_05",
          "row": 0
        },
        {
          "text": "Buồn không hả trống",
          "audio": "cau_b173_06",
          "row": 0
        },
        {
          "text": "Trong những ngày hè",
          "audio": "cau_b173_07",
          "row": 0
        },
        {
          "text": "Bọn mình đi vắng",
          "audio": "cau_b173_08",
          "row": 0
        },
        {
          "text": "Chỉ còn tiếng ve?",
          "audio": "cau_b173_09",
          "row": 0
        },
        {
          "text": "Cái trống lặng im",
          "audio": "cau_b173_10",
          "row": 0
        },
        {
          "text": "Nghiêng đầu trên giá.",
          "audio": "cau_b173_11",
          "row": 0
        },
        {
          "text": "Chắc thấy chúng em",
          "audio": "cau_b173_12",
          "row": 0
        },
        {
          "text": "Nó mừng vui quá!",
          "audio": "cau_b173_13",
          "row": 0
        },
        {
          "text": "Kìa trống đang gọi:",
          "audio": "cau_b173_14",
          "row": 0
        },
        {
          "text": "Tùng! Tùng! Tùng! Tùng!",
          "audio": "cau_b173_15",
          "row": 0
        },
        {
          "text": "Vào năm học mới",
          "audio": "cau_b173_16",
          "row": 0
        },
        {
          "text": "Giọng vang tưng bừng.",
          "audio": "cau_b173_17",
          "row": 0
        }
      ],
