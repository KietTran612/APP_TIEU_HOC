          "audio": "cau_b404_03",
          "row": 0
        },
        {
          "text": "Mồ hôi mà đổ xuống vườn,",
          "audio": "cau_b404_04",
          "row": 0
        },
        {
          "text": "Dâu xanh lá tốt vấn vương tơ tằm.",
          "audio": "cau_b404_05",
          "row": 0
        },
        {
          "text": "Mồ hôi mà đổ xuống đầm,",
          "audio": "cau_b404_06",
          "row": 0
        },
        {
          "text": "Cá lội phía dưới, rau nằm phía trên.",
          "audio": "cau_b404_07",
          "row": 0
        },
        {
          "text": "Mồ hôi xuống, cây mọc lên,",
          "audio": "cau_b404_08",
          "row": 0
        },
        {
          "text": "Ăn no, đánh thắng, dân yên, nước giàu.",
          "audio": "cau_b404_09",
          "row": 0
        }
