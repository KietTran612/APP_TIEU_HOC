          "audio": "cau_b348_10",
          "row": 1
        },
        {
          "text": "Mùa thu năm 1954,",
          "audio": "cau_b348_11",
          "row": 2
        },
        {
          "text": "Bác Hồ tới thăm đền Hùng và đã căn dặn chúng ta:",
          "audio": "cau_b348_12",
          "row": 2
        },
        {
          "text": "\"Các vua Hùng đã có công dựng nước,",
          "audio": "cau_b348_13",
          "row": 2
        },
        {
          "text": "Bác cháu ta phải cùng nhau giữ lấy nước\".",
          "audio": "cau_b348_14",
          "row": 2
        }
      ],
