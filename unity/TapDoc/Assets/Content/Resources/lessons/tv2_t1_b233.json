  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Câu – Hai bộ phận chính",
      "audio": "cau_b233_01",
      "labels": [
        "Tiếp theo"
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Bộ phận chính thứ nhất của câu còn là bộ phận trả lời câu hỏi: Trong câu nói đến con gì? Nói đến cái gì?",
          "audio": "cau_b233_02",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Đặt câu hỏi để tìm bộ phận chính thứ nhất trong hai câu sau:",
      "audio": "hoi_b233_01",
      "rows": [
        {
          "text": "Con chìa vôi vừa hót vừa bay.",
          "audio": "cau_b233_03"
        },
        {
          "text": "Hoa mướp nở vàng rực.",
          "audio": "cau_b233_04"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tìm bộ phận chính thứ nhất trong các câu sau:",
      "audio": "hoi_b233_02",
      "rows": [
        {
          "text": "Bé Hoa đang viết thư cho bố.",
          "audio": "cau_b233_05"
        },
        {
          "text": "Em nắn nót viết từng chữ.",
          "audio": "cau_b233_06"
        },
        {
          "text": "Bức thư đã viết xong.",
          "audio": "cau_b233_07"
        },
        {
          "text": "Con mèo đang lim dim ngủ trên bàn.",
          "audio": "cau_b233_08"
        }
      ]
    }
  ],
