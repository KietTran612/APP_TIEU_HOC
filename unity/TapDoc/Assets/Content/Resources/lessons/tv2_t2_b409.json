  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Tập xếp tên người theo thứ tự bảng chữ cái",
      "audio": "cau_b409_01",
      "labels": [
        "Tiếp theo"
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "1. Những trường hợp không thể dựa vào chữ cái, không thể dựa vào họ hoặc chữ lót để xếp thứ tự thì làm thế nào?",
          "audio": "cau_b409_02",
          "role": "line"
        },
        {
          "text": "Ví dụ: Nguyễn Văn Hàn, Nguyễn Văn Hán, Nguyễn Văn Hãn.",
          "audio": "cau_b409_03",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Trong trường hợp này, người ta dựa vào dấu thanh để xếp theo thứ tự:",
          "audio": "cau_b409_04",
          "role": "line"
        },
        {
          "text": "Thanh ngang (không dấu), thanh huyền, thanh hỏi,",
          "audio": "cau_b409_05",
          "role": "line"
        },
        {
          "text": "thanh ngã, thanh sắc, thanh nặng.",
          "audio": "cau_b409_06",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Vì vậy, ta xếp 3 tên trên theo thứ tự Hàn, Hãn, Hán.",
          "audio": "cau_b409_07",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Em hãy xếp tên các bạn sau đây theo thứ tự bảng chữ cái:",
      "audio": "hoi_b409_01",
      "rows": [
        {
          "text": "Minh, Phùng, Kha, Định, Mạnh,",
          "audio": "cau_b409_08"
        },
        {
          "text": "Khả, Đính, Phụng, Phương, Đinh.",
          "audio": "cau_b409_09"
        }
      ]
    }
  ],
