      ],
      "rows": [
        {
          "text": "Bạn Hải là học sinh giỏi nhất lớp em.",
          "audio": "cau_b327_04",
          "row": 0
        },
        {
          "text": "Bạn ấy đi học rất chuyên cần.",
          "audio": "cau_b327_05",
          "row": 1
        },
        {
          "text": "Ở lớp bạn ấy luôn luôn chăm chú nghe cô giáo giảng bài.",
          "audio": "cau_b327_06",
          "row": 2
        },
        {
          "text": "Ở nhà, Hải cũng chăm chỉ học tập.",
          "audio": "cau_b327_07",
          "row": 3
        },
        {
          "text": "Hải thường ngồi học nghiêm chỉnh ở góc học tập của mình.",
          "audio": "cau_b327_08",
          "row": 4
        },
        {
          "text": "Trên bàn học của bạn ấy, sách vở luôn luôn được xếp đặt rất ngăn nắp.",
