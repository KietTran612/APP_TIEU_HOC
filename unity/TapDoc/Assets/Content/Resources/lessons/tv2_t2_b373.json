      ]
    },
    {
      "type": "passage",
      "marker": "",
      "rows": [
        {
          "text": "Chiều hôm ấy, bãi biển tấp nập hẳn lên.",
          "audio": "cau_b373_02",
          "row": 0
        },
        {
          "text": "Ai cũng muốn xem các đội thuyền ra khơi đánh cá đèn.",
          "audio": "cau_b373_03",
          "row": 0
        },
        {
          "text": "Lũ trẻ cũng theo ra bãi.",
          "audio": "cau_b373_04",
          "row": 0
        },
        {
          "text": "Các thuyền nổ máy ran ran rồi vọt ra khơi,",
          "audio": "cau_b373_05",
          "row": 1
        },
        {
          "text": "trườn nhanh qua vùng sóng lừng.",
          "audio": "cau_b373_06",
          "row": 1
        },
        {
          "text": "Nắng chiều tỏa ánh vàng hoe.",
          "audio": "cau_b373_07",
          "row": 1
        },
        {
          "text": "Màu cầu vồng hiện lên trên bụi nước đầu sóng.",
          "audio": "cau_b373_08",
          "row": 1
        },
        {
          "text": "Mặt trời lặn.",
          "audio": "cau_b373_09",
          "row": 1
        },
        {
          "text": "Màn đêm buông xuống.",
          "audio": "cau_b373_10",
          "row": 1
        },
        {
          "text": "Đèn điện trên các thuyền bật sáng rực rỡ.",
          "audio": "cau_b373_11",
          "row": 1
        },
        {
          "text": "Vài tiếng đồng hồ sau, thấy ánh đèn, cá kéo về đen đặc.",
          "audio": "cau_b373_12",
          "row": 1
        },
        {
          "text": "Những con mối, con nục, nổi lên cuốn vào nhau lúc nhúc.",
          "audio": "cau_b373_13",
          "row": 1
        },
        {
          "text": "Dưới ánh điện, mắt chúng sáng rực cả một vùng như trận mưa tàn lửa...",
          "audio": "cau_b373_14",
          "row": 1
        },
        {
          "text": "Mỗi thuyền chỉ đánh bốn mẻ lưới mà chở không hết cá,",
          "audio": "cau_b373_15",
          "row": 1
        },
        {
          "text": "phải đùn vào lưới thả xuống nước kéo về.",
          "audio": "cau_b373_16",
          "row": 1
        },
        {
          "text": "Thuyền nào cũng no, lặc lè trên sóng.",
          "audio": "cau_b373_17",
          "row": 1
        }
      ],
