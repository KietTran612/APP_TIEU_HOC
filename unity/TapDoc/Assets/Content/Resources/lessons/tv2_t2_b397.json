      ]
    },
    {
      "type": "passage",
      "marker": "",
      "rows": [
        {
          "text": "Một lần, Thủy được một chú công nhân dẫn vào sâu trong công trường.",
          "audio": "cau_b397_02",
          "row": 0
        },
        {
          "text": "Ở tít trên cao, lại đội chiếc mũ hàn che kín mặt,",
          "audio": "cau_b397_03",
          "row": 1
        },
        {
          "text": "thế mà mẹ vẫn nhìn thấy Thủy.",
          "audio": "cau_b397_04",
          "row": 1
        },
        {
          "text": "Mẹ cởi mũ, cười.",
          "audio": "cau_b397_05",
          "row": 1
        },
        {
          "text": "Còn Thủy thì đứng dưới, giơ bàn tay bé xíu vẫy chào mẹ.",
          "audio": "cau_b397_06",
          "row": 1
        },
        {
          "text": "Rồi mẹ quay sang phía chiếc cần cẩu cao lêu đêu.",
          "audio": "cau_b397_07",
          "row": 1
        },
        {
          "text": "Chiếc cần cẩu đang chìa bàn tay sắt tới chỗ mẹ.",
          "audio": "cau_b397_08",
          "row": 1
        },
        {
          "text": "Một chốc sau,",
          "audio": "cau_b397_09",
          "row": 1
        },
        {
          "text": "Thủy nhận được hai chiếc kẹo mẹ gói vội trong một tờ giấy nhỏ,",
          "audio": "cau_b397_10",
          "row": 1
        },
        {
          "text": "gửi theo xuống.",
          "audio": "cau_b397_11",
          "row": 1
        },
        {
          "text": "Một cô công nhân rất trẻ vừa nhanh nhẹn móc dây vào tấm bê tông,",
          "audio": "cau_b397_12",
          "row": 2
        },
        {
          "text": "vừa cười và nói:",
          "audio": "cau_b397_13",
          "row": 2
        },
        {
          "text": "- Thủy có muốn lên với mẹ không, ngồi vào đây,",
          "audio": "cau_b397_14",
          "row": 3
        },
        {
          "text": "cô bảo cần cẩu bế lên?",
          "audio": "cau_b397_15",
          "row": 3
        },
        {
          "text": "Thủy bẽn lẽn đứng im, lắc đầu.",
          "audio": "cau_b397_16",
          "row": 4
        }
      ],
