      "items": [
        {
          "text": "Đầu hồi: hai bên đầu nhà.",
          "audio": "cau_b220_14",
          "role": "line"
        },
        {
          "text": "Mộc mạc: đơn sơ, giản dị.",
          "audio": "cau_b220_15",
          "role": "line"
        },
        {
          "text": "Xoan: tên một loại cây (có vùng gọi là cây sầu đông).",
