          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Trước ngõ ngôi nhà có gì đẹp và đáng yêu?",
      "audio": "hoi_b220_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Đầu hồi có tiếng gì vui?",
      "audio": "hoi_b220_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Ngôi nhà này làm bằng gì? Lợp bằng gì?",
      "audio": "hoi_b220_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Tại sao ngôi nhà mộc mạc nhưng đáng yêu?",
      "audio": "hoi_b220_04"
    },
    {
      "type": "question",
      "marker": "",
      "text": "5. Tìm thêm các từ chỉ mùi thơm như: thơm phức.",
      "audio": "hoi_b220_05"
    },
