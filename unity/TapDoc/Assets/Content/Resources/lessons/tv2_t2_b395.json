    {
      "type": "passage",
      "marker": "",
      "rows": [
        {
          "text": "Bến cảng lúc nào cũng đông vui.",
          "audio": "cau_b395_02",
          "row": 0
        },
        {
          "text": "Tàu mẹ, tàu con đậu đầy mặt nước.",
          "audio": "cau_b395_03",
          "row": 0
        },
        {
          "text": "Xe anh, xe em tíu tít nhận hàng về và chở hàng ra.",
          "audio": "cau_b395_04",
          "row": 0
        },
        {
          "text": "Tất cả đều bận rộn.",
          "audio": "cau_b395_05",
          "row": 0
        },
        {
          "text": "Nhưng hăng hái nhất và khỏe nhất là bác Cần trục.",
          "audio": "cau_b395_06",
          "row": 0
        },
        {
          "text": "Người bác không cao to, tiếng bác không ầm ĩ,",
          "audio": "cau_b395_07",
          "row": 0
        },
        {
          "text": "chỉ có cái cánh tay của bác thì thật là đặc biệt.",
          "audio": "cau_b395_08",
          "row": 0
        },
        {
          "text": "Cái cánh tay ấy vươn lên, sừng sững và chuyển động rất chậm, rất chậm.",
          "audio": "cau_b395_09",
          "row": 1
        },
        {
          "text": "Tàu nào có hàng cần bốc lên là Cần trục vươn tới.",
          "audio": "cau_b395_10",
          "row": 1
        },
        {
          "text": "Hòm nhỏ, hòm to, Cần trục xách một tay cứ như không.",
          "audio": "cau_b395_11",
          "row": 1
        },
        {
          "text": "Cả những chiếc ô tô, những cỗ máy lớn,",
          "audio": "cau_b395_12",
          "row": 1
        },
        {
          "text": "Cần trục cũng chỉ khẽ cúi xuống,",
          "audio": "cau_b395_13",
          "row": 1
        },
        {
          "text": "vươn tay ra, móc lấy sợi dây chằng rồi từ từ nhấc lên.",
          "audio": "cau_b395_14",
          "row": 1
        },
        {
          "text": "Cần trục đúng là cánh tay kì diệu của các chú công nhân.",
          "audio": "cau_b395_15",
          "row": 2
        }
      ],
