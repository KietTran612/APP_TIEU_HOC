        },
        {
          "text": "- Chíp! Chíp!",
          "audio": "cau_b339_07",
          "row": 2
        },
        {
          "text": "Chim lớn dỗ dành:",
          "audio": "cau_b339_08",
          "row": 3
        },
        {
          "text": "- Ti ri... ti ri...",
          "audio": "cau_b339_09",
          "row": 4
        },
        {
          "text": "Không ai biết trên cây sấu ấy có con chim lớn",
          "audio": "cau_b339_10",
          "row": 5
        },
        {
          "text": "đang che chở cho con chim bé dưới trời mưa gió.",
          "audio": "cau_b339_11",
          "row": 5
        },
        {
          "text": "Sáng hôm sau, khi tia nắng óng ánh vừa rơi xuống chỗ ẩn nấp,",
          "audio": "cau_b339_12",
          "row": 6
        },
        {
          "text": "con chim lớn mở choàng mắt.",
          "audio": "cau_b339_13",
          "row": 6
        },
        {
          "text": "Nó giũ giũ lông cánh cho khô rồi khẽ nhích ra ngoài.",
          "audio": "cau_b339_14",
          "row": 6
        },
        {
          "text": "Tia nắng ấm vừa vặn rơi xuống đúng chỗ con chim non đang ngái ngủ,",
          "audio": "cau_b339_15",
          "row": 6
        },
        {
          "text": "lông cánh vẫn khô nguyên.",
          "audio": "cau_b339_16",
          "row": 6
        }
      ],
