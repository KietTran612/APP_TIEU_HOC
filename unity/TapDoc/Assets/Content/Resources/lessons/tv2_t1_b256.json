  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Ôn tập câu",
      "audio": "cau_b256_01",
      "labels": []
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Tại sao nói và viết phải thành câu?",
      "audio": "hoi_b256_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Khi viết, hết câu ta phải làm gì? Chữ đầu câu phải viết như thế nào?",
      "audio": "hoi_b256_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "3. Đoạn văn sau đây có mấy câu? Viết lại, chấm câu cho đúng.",
      "audio": "hoi_b256_03",
      "rows": [
        {
          "text": "Nhân dân ta rất anh hùng đất nước ta vô cùng tươi đẹp chúng em cố gắng học giỏi chúng ta xây dựng Tổ quốc giàu mạnh",
          "audio": "cau_b256_02"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Câu có mấy bộ phận chính?",
      "audio": "hoi_b256_04"
    },
    {
      "type": "question",
      "marker": "",
      "text": "5. Bộ phận chính thứ nhất trả lời câu hỏi nào?",
      "audio": "hoi_b256_05"
    },
    {
      "type": "question",
      "marker": "",
      "text": "6. Tìm bộ phận chính thứ nhất trong mấy câu sau:",
      "audio": "hoi_b256_06",
      "rows": [
        {
          "text": "Chúng em yêu quý Tổ quốc Việt Nam.",
          "audio": "cau_b256_03"
        },
        {
          "text": "Con rùa nhô đầu lên khỏi mặt nước.",
          "audio": "cau_b256_04"
        },
        {
          "text": "Dòng sông rì rào hát ca.",
          "audio": "cau_b256_05"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "7. Bộ phận chính thứ hai trả lời câu hỏi nào?",
      "audio": "hoi_b256_07"
    },
    {
      "type": "question",
      "marker": "",
      "text": "8. Tìm bộ phận chính thứ hai trong mấy câu sau:",
      "audio": "hoi_b256_08",
      "rows": [
        {
          "text": "Em ra thăm bến cảng.",
          "audio": "cau_b256_06"
        },
        {
          "text": "Nền trời rực hồng.",
          "audio": "cau_b256_07"
        },
        {
          "text": "Đồng ruộng quê hương đẹp như một bức tranh.",
          "audio": "cau_b256_08"
        }
      ]
    }
  ],
