          "text": "Còn Vạc thì lười biếng, suốt ngày chỉ nằm ngủ.",
          "audio": "cau_b196_05",
          "row": 0
        },
        {
          "text": "Cò bảo mãi, Vạc chẳng nghe.",
          "audio": "cau_b196_06",
          "row": 0
        },
        {
          "text": "Nhờ chăm chỉ siêng năng nên Cò học giỏi nhất lớp.",
          "audio": "cau_b196_07",
          "row": 1
        },
        {
          "text": "Còn Vạc thì chịu ngu dốt.",
          "audio": "cau_b196_08",
          "row": 1
        },
        {
          "text": "Sợ chúng bạn chế nhạo, ban đêm Vạc mới bay đi kiếm ăn.",
          "audio": "cau_b196_09",
          "row": 1
        },
        {
          "text": "Ngày nay, chúng ta lật cánh Cò lên,",
          "audio": "cau_b196_10",
          "row": 2
        },
        {
          "text": "vẫn thấy một dúm lông màu vàng nhạt,",
          "audio": "cau_b196_11",
          "row": 2
        },
        {
          "text": "người ta bảo đó là quyển sách của Cò.",
          "audio": "cau_b196_12",
          "row": 2
        },
        {
          "text": "Cò rất chăm học nên lúc nào cũng mang sách theo.",
          "audio": "cau_b196_13",
          "row": 2
        },
        {
          "text": "Sau những buổi mò tôm bắt ốc,",
          "audio": "cau_b196_14",
          "row": 2
        },
        {
          "text": "Cò lại đậu trên ngọn tre giở sách ra học.",
          "audio": "cau_b196_15",
          "row": 2
        }
      ],
