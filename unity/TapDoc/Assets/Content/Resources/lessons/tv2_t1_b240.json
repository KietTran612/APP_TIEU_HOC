  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Câu – Hai bộ phận chính",
      "audio": "cau_b240_01",
      "labels": [
        "Tiếp theo"
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Chị Thùy Linh quét nhà.",
          "audio": "cau_b240_02",
          "role": "line"
        },
        {
          "text": "Hỏi: Trong câu nói đến ai?",
          "audio": "cau_b240_03",
          "role": "line"
        },
        {
          "text": "Trả lời: Nói đến \"Chị Thùy Linh\".",
          "audio": "cau_b240_04",
          "role": "line"
        },
        {
          "text": "Vậy \"Chị Thùy Linh\" là bộ phận chính thứ nhất của câu.",
          "audio": "cau_b240_05",
          "role": "line"
        },
        {
          "text": "Hỏi: \"Chị Thùy Linh\" làm gì?",
          "audio": "cau_b240_06",
          "role": "line"
        },
        {
          "text": "Trả lời: \"Quét nhà\".",
          "audio": "cau_b240_07",
          "role": "line"
        },
        {
          "text": "Kết luận: \"Quét nhà\" là bộ phận chính thứ hai của câu.",
          "audio": "cau_b240_08",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Bộ phận chính thứ hai của câu là bộ phận trả lời câu hỏi \"... làm gì?\"",
          "audio": "cau_b240_09",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "Đặt câu hỏi để tìm bộ phận chính thứ hai trong các câu sau:",
      "audio": "hoi_b240_01",
      "rows": [
        {
          "text": "Bà tôi kể nhiều truyện cổ tích.",
          "audio": "cau_b240_10"
        },
        {
          "text": "Gà mẹ che chở cho con.",
          "audio": "cau_b240_11"
        },
        {
          "text": "Bố bạn Tuấn đóng bàn ghế.",
          "audio": "cau_b240_12"
        }
      ]
    }
  ],
