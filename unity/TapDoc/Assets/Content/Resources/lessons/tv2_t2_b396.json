      "labels": [
        "V. MAI-A-CỐP-XKI (Nga)",
        "poem"
      ]
    },
    {
      "type": "question",
      "marker": "?",
      "text": "1. Em bé tưởng tượng khi bay lên trời sẽ được làm bạn với ai?",
      "audio": "hoi_b396_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Em bé cũng tưởng tượng sẽ được bay qua những đâu và bay tới những nơi nào?",
      "audio": "hoi_b396_02"
    },
    {
      "type": "question",
      "marker": "",
      "text": "*3. Tìm trong bài những từ ngữ tả các cách bay khác nhau của em bé.",
      "audio": "hoi_b396_03"
    },
    {
      "type": "question",
      "marker": "",
      "text": "4. Tìm một số từ ghép có tiếng xa ở đầu. Ví dụ: (xa lắc).",
      "audio": "hoi_b396_04"
    },
    {
      "type": "memorize",
      "marker": "",
      "rows": [
        {
          "text": "Em muốn lái máy bay",
          "audio": "cau_b396_02",
          "row": 0
        },
        {
          "text": "Miễn dạy em cầm lái.",
          "audio": "cau_b396_03",
          "row": 0
        },
        {
          "text": "Đổ xăng vào bình chứa,",
          "audio": "cau_b396_04",
          "row": 0
        },
        {
          "text": "Nổ máy, cánh quạt quay.",
          "audio": "cau_b396_05",
          "row": 0
        },
        {
          "text": "\"Vù lên trời, máy ơi,",
          "audio": "cau_b396_06",
          "row": 0
        },
        {
          "text": "Cùng với chim ca hót\".",
          "audio": "cau_b396_07",
          "row": 0
        },
        {
          "text": "Chẳng sợ gió",
          "audio": "cau_b396_08",
          "row": 0
        },
        {
          "text": "Sợ mưa gì hết.",
          "audio": "cau_b396_09",
          "row": 0
        },
        {
          "text": "Tôi bay qua đám mây,",
          "audio": "cau_b396_10",
          "row": 0
        },
        {
          "text": "Lửng lơ lưng chừng trời",
          "audio": "cau_b396_11",
          "row": 0
        },
        {
          "text": "Lượn như chim âu trắng,",
          "audio": "cau_b396_12",
          "row": 0
        },
        {
          "text": "Tôi bay trên biển nắng.",
          "audio": "cau_b396_13",
          "row": 0
        },
        {
          "text": "Núi kia cao đến đâu,",
          "audio": "cau_b396_14",
          "row": 0
        },
        {
          "text": "Cũng bay vượt trên đầu.",
          "audio": "cau_b396_15",
          "row": 0
        },
        {
          "text": "\"Mây ơi, đưa ta đi",
          "audio": "cau_b396_16",
          "row": 0
        },
        {
          "text": "lên tận trăng, sao",
          "audio": "cau_b396_17",
          "row": 0
        },
        {
          "text": "Dấu trăng, sao",
          "audio": "cau_b396_18",
          "row": 0
        },
        {
          "text": "xa lơ xa lắc\".",
          "audio": "cau_b396_19",
          "row": 0
        }
      ],
