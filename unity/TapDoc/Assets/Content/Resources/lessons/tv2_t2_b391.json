  "notes": [
    {
      "kind": "khac_sach",
      "text": "Phần chép, viết vào vở không có trong app: bé viết vào vở cùng bố mẹ. Mục \"Viết đúng\" thành bước đọc."
    },
    {
      "kind": "khac_sach",
      "text": "Ghép chữ, điền chỗ trống, tìm chữ có dấu hỏi làm bằng chạm thẻ, chạm chữ; thêm chữ: bé nói cùng bố mẹ; cặp từ so sánh thành thẻ chạm để nghe. Dấu \"≠\" thay bằng dấu phẩy."
    }
  ],
