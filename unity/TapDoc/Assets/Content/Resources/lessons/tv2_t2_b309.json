  "notes": [
    {
      "kind": "khac_sach",
      "text": "Phần chép, viết vào vở không có trong app: bé viết vào vở cùng bố mẹ. Mục \"Viết đúng\" thành bước đọc."
    },
    {
      "kind": "khac_sach",
      "text": "Ghép chữ, điền chỗ trống, gạch dưới chữ làm bằng chạm vào thẻ hoặc vào chữ."
    },
    {
      "kind": "khac_sach",
      "text": "Cụm \"say ... nghe chuyện\" rút ngắn thành \"say sưa\" cho vừa khung."
    }
  ],
