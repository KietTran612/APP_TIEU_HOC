        {
          "text": "Cả đàn ùa xuống, líu tíu trên những luống rau trồng muộn.",
          "audio": "cau_b190_12",
          "row": 2
        },
        {
          "text": "Bé hỏi:",
          "audio": "cau_b190_13",
          "row": 3
        },
        {
          "text": "- Chích bông ơi chích bông, làm gì thế?",
          "audio": "cau_b190_14",
          "row": 4
        },
        {
          "text": "Chim trả lời:",
          "audio": "cau_b190_15",
          "row": 5
        },
        {
          "text": "- Chúng em bắt sâu.",
          "audio": "cau_b190_16",
          "row": 6
        },
        {
          "text": "Chim hỏi lại Bé:",
          "audio": "cau_b190_17",
          "row": 7
        },
        {
          "text": "- Chị Bé làm gì thế?",
          "audio": "cau_b190_18",
          "row": 8
        },
        {
          "text": "Bé ngẩn ra, rồi nói:",
          "audio": "cau_b190_19",
          "row": 9
        },
        {
          "text": "- À... Bé học bài.",
          "audio": "cau_b190_20",
          "row": 10
        }
      ],
