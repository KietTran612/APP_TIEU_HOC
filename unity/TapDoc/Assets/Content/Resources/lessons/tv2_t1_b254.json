      "text": "Gạch dưới những chữ yêu trong bài chính tả.",
      "audio": "hoi_b254_03",
      "rows": [
        {
          "text": "Yêu từng bờ ruộng, lối mòn,",
          "audio": "cau_b254_13",
          "row": 0
        },
        {
          "text": "Đỏ tươi bông gạo, biếc rờn ngàn dâu.",
          "audio": "cau_b254_14",
          "row": 0
