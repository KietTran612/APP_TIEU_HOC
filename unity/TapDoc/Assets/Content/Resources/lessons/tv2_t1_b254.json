        {
          "text": "Yêu con sông mặt sóng xao,",
          "audio": "cau_b254_15",
          "row": 0
        },
        {
          "text": "Dòng sông tuổi nhỏ rì rào hát ca.",
          "audio": "cau_b254_16",
          "row": 0
