  "part1": [
    {
      "type": "title",
      "marker": "",
      "text": "Ngữ pháp: Tiếng và từ",
      "audio": "cau_b272_01",
      "labels": []
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Từ thì phải có nghĩa.",
          "audio": "cau_b272_02",
          "role": "line"
        },
        {
          "text": "Tiếng có lúc không có nghĩa.",
          "audio": "cau_b272_03",
          "role": "line"
        },
        {
          "text": "Có từ chỉ có một tiếng.",
          "audio": "cau_b272_04",
          "role": "line"
        },
        {
          "text": "Lại có từ gồm hai, ba tiếng.",
          "audio": "cau_b272_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Ví dụ: Long lanh đáy nước in trời.",
          "audio": "cau_b272_06",
          "role": "line"
        },
        {
          "text": "Long lanh là từ hai tiếng.",
          "audio": "cau_b272_07",
          "role": "line"
        },
        {
          "text": "đáy, nước, in và trời là những từ một tiếng.",
          "audio": "cau_b272_08",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Tìm từ trong ba câu sau:",
      "audio": "hoi_b272_01",
      "rows": [
        {
          "text": "Nụ hoa xanh màu ngọc bích.",
          "audio": "cau_b272_09"
        },
        {
          "text": "Đồng lúa rộng mênh mông.",
          "audio": "cau_b272_10"
        },
        {
          "text": "Tổ quốc ta vô cùng tươi đẹp.",
          "audio": "cau_b272_11"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Tìm một từ hai tiếng và dùng từ đó đặt câu.",
      "audio": "hoi_b272_02"
    }
  ],
