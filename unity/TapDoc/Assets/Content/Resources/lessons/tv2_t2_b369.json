    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Tên người gồm 2 tiếng: Lê Lợi, Trần Phú.",
          "audio": "cau_b369_02",
          "role": "line"
        },
        {
          "text": "Tên người gồm 3 tiếng: Hồ Chí Minh, Tôn Đức Thắng.",
          "audio": "cau_b369_03",
          "role": "line"
        },
        {
          "text": "Tên người gồm 4 tiếng: Nguyễn Thị Minh Khai, Lê Thị Hồng Gấm.",
          "audio": "cau_b369_04",
          "role": "line"
        }
      ]
    },
    {
      "type": "rule",
      "marker": "",
      "items": [
        {
          "text": "Tên người Việt Nam gồm 2 tiếng, 3 tiếng, 4 tiếng... đều phải viết hoa chữ cái ở đầu mỗi tiếng.",
          "audio": "cau_b369_05",
          "role": "line"
        }
      ]
    },
    {
      "type": "question",
      "marker": "",
      "text": "1. Hãy viết đúng họ tên 3 bạn ở tổ em.",
      "audio": "hoi_b369_01"
    },
    {
      "type": "question",
      "marker": "",
      "text": "2. Em hãy viết lại cho đúng chính tả tất cả các tên người sau đây:",
      "audio": "hoi_b369_02",
      "rows": [
        {
          "text": "nguyễn bá ngọc",
          "audio": "cau_b369_06"
        },
        {
          "text": "lê văn tám",
          "audio": "cau_b369_07"
        },
        {
          "text": "vừ a dính",
          "audio": "cau_b369_08"
        },
        {
          "text": "trần quốc toản",
          "audio": "cau_b369_09"
        },
        {
          "text": "võ thị sáu",
          "audio": "cau_b369_10"
        },
        {
          "text": "kim đồng",
          "audio": "cau_b369_11"
        }
      ]
    }
